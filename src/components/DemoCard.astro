---
export interface Props {
    title: string;
    description: string;
    icon: string;
    url: string;
    githubUrl?: string;
    tags: string[];
    status?: 'live' | 'development' | 'preview';
    gradient: 'primary' | 'secondary' | 'accent';
    id: string;
}

const { title, description, icon, url, githubUrl, tags, status = 'live', gradient, id } = Astro.props;

const gradientClasses = {
    primary: 'bg-gradient-to-br from-primary/30 to-secondary/30',
    secondary: 'bg-gradient-to-br from-secondary/30 to-accent/30',
    accent: 'bg-gradient-to-br from-accent/30 to-primary/30'
};

const statusColors = {
    live: 'text-green-500',
    development: 'text-yellow-500',
    preview: 'text-blue-500'
};
---

<div class="project-card group">
    <div class="mb-4">
        <div class={`w-full h-40 ${gradientClasses[gradient]} rounded-lg flex items-center justify-center transition-transform group-hover:scale-105`}>
            <span class="text-3xl">{icon}</span>
        </div>
    </div>

    <div class="flex items-center gap-2 mb-3">
        <h3 class="gradient-text">{title}</h3>
        {
            status && (
                <span class={`text-xs px-2 py-1 rounded-full ${statusColors[status]} bg-opacity-20`}>
                    {status === 'development' ? 'In Dev' : status === 'preview' ? 'Preview' : 'Live'}
                </span>
            )
        }
    </div>

    <p class="mb-4 text-sm text-text-muted">{description}</p>

    <div class="flex flex-wrap gap-1 mb-4">
        {tags.map((tag) => <span class="text-xs px-2 py-1 bg-background-secondary rounded-full text-text-muted">{tag}</span>)}
    </div>

    <div class="flex gap-2">
        <a href={url} target="_blank" rel="noopener noreferrer" class="btn text-sm">
            {status === 'development' ? 'Preview' : 'Try Demo'}
        </a>
        {
            githubUrl && (
                <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline text-sm">
                    Code
                </a>
            )
        }
        <a href={`/demos/${id}`} class="btn btn-outline text-sm">Details</a>
    </div>
</div>
