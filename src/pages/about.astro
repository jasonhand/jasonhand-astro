---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About - Jason Hand">
    <!-- Hero Section -->
    <section class="section-hero relative">
        <!-- Background Image -->
        <div class="absolute top-0 right-0 bottom-0 flex items-center pointer-events-none" style="transform: translateY(20px);">
            <img src="/images/About.png" alt="Jason Hand" class="w-72 md:w-96 lg:w-[30rem] h-auto opacity-20 select-none soft-fade-image" />
        </div>

        <div class="max-w-4xl mx-auto text-center relative z-10">
            <h1 class="mb-8">
                <span class="scattered-letters">
                    <span>A</span><span>b</span><span>o</span><span>u</span><span>t</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>M</span><span>e</span>
                </span>
            </h1>
            <p class="text-xl md:text-2xl mb-12 max-w-2xl mx-auto">Passionate about creating digital experiences that make a difference.</p>
        </div>
    </section>

    <!-- Story Section -->
    <section class="section">
        <div class="max-w-4xl mx-auto">
            <div class="grid md:grid-cols-2 gap-16 items-center mb-20">
                <div>
                    <h2 class="mb-8 gradient-text">My Story</h2>
                    <p class="mb-6">
                        I've been fascinated by technology and its potential to solve problems since I wrote my first line of code. What started as curiosity
                        has evolved into a career dedicated to crafting digital experiences that matter.
                    </p>
                    <p class="mb-6">
                        Over the years, I've had the privilege of working with startups and established companies, helping them bring their visions to life
                        through thoughtful design and robust development.
                    </p>
                </div>
                <div class="relative">
                    <div class="w-full h-96 bg-gradient-to-br from-secondary/20 to-accent/20 rounded-2xl flex items-center justify-center">
                        <span class="text-6xl gradient-text-secondary">🚀</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Experience Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-16">
                <span class="scattered-letters">
                    <span>E</span><span>x</span><span>p</span><span>e</span><span>r</span><span>i</span><span>e</span><span>n</span><span>c</span><span>e</span>
                </span>
            </h2>
            <div class="grid md:grid-cols-2 gap-8">
                <div class="project-card">
                    <h3 class="mb-4 gradient-text">Developer Relations</h3>
                    <p class="mb-4">
                        Over 10+ years of DevRel experience, building and supporting developer communities while creating impactful content and educational
                        resources.
                    </p>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">Community Building</span>
                        <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">Content Strategy</span>
                        <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">Event Production</span>
                        <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">Podcasting</span>
                    </div>
                </div>
                <div class="project-card">
                    <h3 class="mb-4 gradient-text-secondary">DevOps & SRE</h3>
                    <p class="mb-4">Deep expertise in modern DevOps practices, site reliability engineering, and building scalable, reliable systems.</p>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 bg-secondary/20 text-secondary rounded-full text-sm">Azure DevOps</span>
                        <span class="px-3 py-1 bg-secondary/20 text-secondary rounded-full text-sm">Monitoring</span>
                        <span class="px-3 py-1 bg-secondary/20 text-secondary rounded-full text-sm">Automation</span>
                        <span class="px-3 py-1 bg-secondary/20 text-secondary rounded-full text-sm">Infrastructure</span>
                    </div>
                </div>
                <div class="project-card">
                    <h3 class="mb-4 gradient-text">AI & Emerging Tech</h3>
                    <p class="mb-4">
                        Leading AI initiatives and exploring cutting-edge technologies to solve complex problems and enhance developer experiences.
                    </p>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-sm">AI/ML</span>
                        <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-sm">Serverless</span>
                        <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-sm">Data Analytics</span>
                        <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-sm">Innovation</span>
                    </div>
                </div>
                <div class="project-card">
                    <h3 class="mb-4 gradient-text-secondary">Content & Media</h3>
                    <p class="mb-4">Creating engaging technical content across multiple platforms including video, live streaming, and digital media.</p>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">Video Production</span>
                        <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">Live Streaming</span>
                        <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">Technical Writing</span>
                        <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">Social Media</span>
                    </div>
                </div>
                <div class="project-card">
                    <h3 class="mb-4 gradient-text">Conference Leadership</h3>
                    <p class="mb-4">Founding and operating technical conferences, including starting the first DevOpsDays Rockies in Denver in 2015.</p>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-sm">Event Planning</span>
                        <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-sm">Community Organizing</span>
                        <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-sm">DevOpsDays</span>
                        <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-sm">Volunteer Management</span>
                    </div>
                </div>
                <div class="project-card">
                    <h3 class="mb-4 gradient-text-secondary">Systems & Solutions Architecture</h3>
                    <p class="mb-4">
                        Designing and building comprehensive tooling and infrastructure to support complex projects like AI Tools Lab, including automation,
                        analytics, and content management systems.
                    </p>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 bg-secondary/20 text-secondary rounded-full text-sm">System Design</span>
                        <span class="px-3 py-1 bg-secondary/20 text-secondary rounded-full text-sm">Automation</span>
                        <span class="px-3 py-1 bg-secondary/20 text-secondary rounded-full text-sm">Content Management</span>
                        <span class="px-3 py-1 bg-secondary/20 text-secondary rounded-full text-sm">Analytics</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="section">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="mb-8 gradient-text">Explore My Work</h2>
            <p class="text-xl mb-12">Discover the projects and innovations I've been working on across different domains and technologies.</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
                <a href="/projects" class="btn btn-lg">View My Datadog Work</a>
                <a href="/demos" class="btn btn-lg btn-outline">Explore Demos</a>
                <a href="/contact" class="btn btn-lg btn-outline">Get In Touch</a>
            </div>

            <!-- Social Links -->
            <div class="border-t border-gray-800 pt-12">
                <h3 class="mb-6 gradient-text-secondary">Connect With Me</h3>
                <div class="flex flex-wrap justify-center gap-6">
                    <a href="https://youtube.com/@jhand" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-primary transition-colors">
                        📺 YouTube
                    </a>
                    <a
                        href="https://github.com/jasonhand"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-secondary transition-colors"
                    >
                        💻 GitHub
                    </a>
                    <a
                        href="https://www.tiktok.com/@jason.hand"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-accent transition-colors"
                    >
                        🎵 TikTok
                    </a>
                    <a
                        href="https://www.linkedin.com/in/jasonhand24"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-primary transition-colors"
                    >
                        💼 LinkedIn
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>

<style>
    .soft-fade-image {
        filter: blur(0.5px);
        mask: radial-gradient(ellipse at center, black 60%, transparent 100%);
        -webkit-mask: radial-gradient(ellipse at center, black 60%, transparent 100%);
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.3);
    }
</style>
