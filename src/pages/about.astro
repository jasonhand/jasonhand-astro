---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About - Jason Hand">
    <!-- Hero Section -->
    <section class="section-hero relative">
        <!-- Background Image -->
        <div class="absolute top-0 right-0 bottom-0 flex items-center pointer-events-none" style="transform: translateY(20px);">
            <img src="/images/About.png" alt="Jason Hand" class="w-72 md:w-96 lg:w-[30rem] h-auto opacity-20 select-none soft-fade-image" />
        </div>

        <div class="max-w-4xl mx-auto text-center relative z-10">
            <h1 class="mb-8">
                <span class="scattered-letters">
                    <span>A</span><span>b</span><span>o</span><span>u</span><span>t</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>M</span><span>e</span>
                </span>
            </h1>
            <p class="text-xl md:text-2xl mb-12 max-w-2xl mx-auto">
                Developer Relations Leader | Published Author | Community Builder | 10+ Years Empowering Developers
            </p>
        </div>
    </section>

    <!-- Story Section -->
    <section class="section">
        <div class="max-w-4xl mx-auto">
            <div class="grid md:grid-cols-2 gap-16 items-center mb-20">
                <div>
                    <h2 class="mb-8 gradient-text">My Story</h2>
                    <p class="mb-6">
                        I'm a Developer Relations leader with over 10 years of experience building communities, creating educational content, and empowering
                        developers to solve complex problems. Currently, I lead developer advocacy projects and initiatives at Datadog, where I focus on
                        observability, AI tools, and helping teams build more reliable systems.
                    </p>
                    <p class="mb-6">
                        My journey in tech began with a passion for solving real-world problems with human empathy and a little bit of technology when needed.
                        This evolved into a career spanning IT operations, system adminstration, technical support, developer relations, community building,
                        technical writing, project mangaement, conference organizing and so much more. I've had the privilege of working with organizations like
                        Datadog, VictorOps, and various startups, helping shape modern DevOps and SRE practices.
                    </p>
                    <p class="mb-6">
                        Beyond my day job, I'm a published author with 6 books and reports on DevOps, SRE, and ChatOps published by O'Reilly Media and Wiley. I
                        also host the Community Pulse podcast, which has reached 100+ episodes over 10 years, exploring the evolution of the tech industry
                        through conversations with industry leaders.
                    </p>
                </div>
                <div class="relative">
                    <div class="w-full h-96 bg-gradient-to-br from-secondary/20 to-accent/20 rounded-2xl flex items-center justify-center">
                        <span class="text-6xl gradient-text-secondary">🚀</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Experience Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-16">
                <span class="scattered-letters">
                    <span>E</span><span>x</span><span>p</span><span>e</span><span>r</span><span>i</span><span>e</span><span>n</span><span>c</span><span>e</span>
                </span>
            </h2>
            <div class="grid md:grid-cols-2 gap-8">
                <div class="project-card">
                    <h3 class="mb-4 gradient-text">Developer Relations & Advocacy</h3>
                    <p class="mb-4">
                        Over 10+ years leading developer relations initiatives at Datadog and previous organizations. Building developer communities, creating
                        educational content, and empowering teams with observability tools and best practices. Currently focused on AI-native development,
                        observability, and helping developers build more reliable systems.
                    </p>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">Community Building</span>
                        <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">Content Strategy</span>
                        <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">Developer Advocacy</span>
                        <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">Technical Education</span>
                        <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">Event Production</span>
                        <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">Podcasting</span>
                    </div>
                </div>
                <div class="project-card">
                    <h3 class="mb-4 gradient-text-secondary">DevOps & SRE</h3>
                    <p class="mb-4">
                        Deep expertise in modern DevOps practices, site reliability engineering, and building scalable, reliable systems. Published author on
                        SRE practices, incident management, and operational excellence. Experience implementing observability solutions, automation workflows,
                        and helping organizations adopt SRE principles.
                    </p>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 bg-secondary/20 text-secondary rounded-full text-sm">Site Reliability Engineering</span>
                        <span class="px-3 py-1 bg-secondary/20 text-secondary rounded-full text-sm">Observability</span>
                        <span class="px-3 py-1 bg-secondary/20 text-secondary rounded-full text-sm">Monitoring & Alerting</span>
                        <span class="px-3 py-1 bg-secondary/20 text-secondary rounded-full text-sm">Incident Management</span>
                        <span class="px-3 py-1 bg-secondary/20 text-secondary rounded-full text-sm">Automation</span>
                        <span class="px-3 py-1 bg-secondary/20 text-secondary rounded-full text-sm">Infrastructure</span>
                    </div>
                </div>
                <div class="project-card">
                    <h3 class="mb-4 gradient-text">AI & Emerging Tech</h3>
                    <p class="mb-4">
                        Leading AI initiatives at Datadog through the AI Tools Lab, exploring cutting-edge technologies including LLMs, AI assistants, and
                        automation tools. Creating educational content on AI-native development, observability for AI systems, and helping developers integrate
                        AI into their workflows.
                    </p>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-sm">AI/ML</span>
                        <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-sm">LLMs & AI Tools</span>
                        <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-sm">AI Observability</span>
                        <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-sm">MCP Servers</span>
                        <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-sm">Innovation</span>
                    </div>
                </div>
                <div class="project-card">
                    <h3 class="mb-4 gradient-text-secondary">Content & Media</h3>
                    <p class="mb-4">
                        Creating engaging technical content across multiple platforms. Published 6 books and reports with O'Reilly Media and Wiley. Host of the
                        Community Pulse podcast (100+ episodes over 10 years). Regular conference speaker, live streamer, and creator of educational video
                        content on observability, DevOps, and AI tools with hundreds of videos available online.
                    </p>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">Technical Writing</span>
                        <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">Video Production</span>
                        <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">Live Streaming</span>
                        <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">Podcasting</span>
                        <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">Conference Speaking</span>
                    </div>
                </div>
                <div class="project-card">
                    <h3 class="mb-4 gradient-text">Conference Leadership & Speaking</h3>
                    <p class="mb-4">
                        Founded and organized DevOpsDays Rockies in Denver (2015), the first DevOpsDays event in the Rocky Mountain region. Regular speaker at
                        major tech conferences including DASH, partner webinars with Google, Microsoft, AWS, and other industry events. Focus on observability,
                        AI, DevOps practices, and community building.
                    </p>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-sm">Event Planning</span>
                        <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-sm">Community Organizing</span>
                        <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-sm">DevOpsDays</span>
                        <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-sm">Public Speaking</span>
                        <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-sm">Webinar Production</span>
                    </div>
                </div>
                <div class="project-card">
                    <h3 class="mb-4 gradient-text-secondary">Published Author</h3>
                    <p class="mb-4">
                        Author and technical editor of 6 books and reports published by O'Reilly Media and Wiley, including "97 Things Every SRE Should Know",
                        "DevOps For Dummies" (Technical Editor), "ChatOps", "Post-Incident Reviews", and more. These publications have reached thousands of
                        practitioners worldwide and contributed to the evolution of modern operations practices.
                    </p>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 bg-secondary/20 text-secondary rounded-full text-sm">O'Reilly Media</span>
                        <span class="px-3 py-1 bg-secondary/20 text-secondary rounded-full text-sm">Wiley Publishing</span>
                        <span class="px-3 py-1 bg-secondary/20 text-secondary rounded-full text-sm">Technical Writing</span>
                        <span class="px-3 py-1 bg-secondary/20 text-secondary rounded-full text-sm">SRE & DevOps</span>
                        <span class="px-3 py-1 bg-secondary/20 text-secondary rounded-full text-sm">Incident Management</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="section">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="mb-8 gradient-text">Explore My Work</h2>
            <p class="text-xl mb-12">Discover the projects and innovations I've been working on across different domains and technologies.</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
                <a href="/projects" class="btn btn-lg">View My Datadog Work</a>
                <a href="/demos" class="btn btn-lg btn-outline">Explore Demos</a>
            </div>

            <!-- Social Links -->
            <div class="border-t border-gray-800 pt-12">
                <h3 class="mb-6 gradient-text-secondary">Connect With Me</h3>
                <div class="flex flex-wrap justify-center gap-6">
                    <a href="https://youtube.com/@jhand" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-primary transition-colors">
                        📺 YouTube
                    </a>
                    <a
                        href="https://github.com/jasonhand"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-secondary transition-colors"
                    >
                        💻 GitHub
                    </a>
                    <a
                        href="https://www.tiktok.com/@jason.hand"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-accent transition-colors"
                    >
                        🎵 TikTok
                    </a>
                    <a
                        href="https://www.linkedin.com/in/jasonhand24"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-primary transition-colors"
                    >
                        💼 LinkedIn
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>

<style>
    .soft-fade-image {
        filter: blur(0.5px);
        mask: radial-gradient(ellipse at center, black 60%, transparent 100%);
        -webkit-mask: radial-gradient(ellipse at center, black 60%, transparent 100%);
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.3);
    }
</style>
