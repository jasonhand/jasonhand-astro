---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact - Jason Hand">
    <!-- Hero Section -->
    <section class="section-hero">
        <div class="max-w-4xl mx-auto text-center">
            <h1 class="mb-8">
                <span class="scattered-letters">
                    <span>C</span><span>o</span><span>n</span><span>t</span><span>a</span><span>c</span><span>t</span>
                </span>
            </h1>
            <p class="text-xl md:text-2xl mb-12 max-w-2xl mx-auto">
                Let's connect! Whether you have a question, want to collaborate, or just want to say hello.
            </p>
        </div>
    </section>

    <!-- Contact Form Section -->
    <section class="section">
        <div class="max-w-4xl mx-auto">
            <!-- Google Form -->
            <div class="project-card mb-16">
                <h3 class="mb-6 gradient-text-secondary">Send a Message</h3>
                <div class="google-form-container">
                    <iframe
                        src="https://docs.google.com/forms/d/e/1FAIpQLSfe7gfYBQ8H3CV_Dg58iLF57P5Ipkn0umyy0Qed7Tw6ruKQxg/viewform?embedded=true"
                        width="100%"
                        height="600"
                        frameborder="0"
                        marginheight="0"
                        marginwidth="0"
                        title="Contact Form"
                        class="google-form-iframe"
                    >
                        Loading…
                    </iframe>
                </div>
            </div>

            <!-- Alternative Contact Section -->
            <section class="section">
                <div class="max-w-4xl mx-auto text-center">
                    <h2 class="mb-8 gradient-text">Other Ways to Connect</h2>
                    <p class="text-xl mb-12">Prefer to reach out through social media or other channels?</p>
                    <div class="flex flex-wrap justify-center gap-6">
                        <a
                            href="https://youtube.com/@jhand"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-text-muted hover:text-primary transition-colors"
                        >
                            📺 YouTube
                        </a>
                        <a
                            href="https://github.com/jasonhand"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-text-muted hover:text-secondary transition-colors"
                        >
                            💻 GitHub
                        </a>
                        <a
                            href="https://www.tiktok.com/@jason.hand"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-text-muted hover:text-accent transition-colors"
                        >
                            🎵 TikTok
                        </a>
                        <a
                            href="https://www.linkedin.com/in/jasonhand24"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-text-muted hover:text-primary transition-colors"
                        >
                            💼 LinkedIn
                        </a>
                    </div>
                </div>
            </section>
        </div>

        <style>
            .google-form-container {
                position: relative;
                width: 100%;
                border-radius: 0.5rem;
                overflow: hidden;
                background: var(--surface);
            }

            .google-form-iframe {
                border: none;
                border-radius: 0.5rem;
                background: transparent;
            }

            /* Responsive adjustments for the form */
            @media (max-width: 768px) {
                .google-form-iframe {
                    height: 500px;
                }
            }
        </style>
    </section></Layout
>
