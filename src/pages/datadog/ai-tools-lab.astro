---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="AI Tools Lab - Datadog - Jason Hand">
    <!-- Hero Section -->
    <section class="section-hero">
        <div class="max-w-4xl mx-auto text-center">
            <!-- Breadcrumb -->
            <div class="mb-6">
                <a href="/projects" class="text-text-muted hover:text-primary transition-colors">Datadog</a>
                <span class="text-text-muted mx-2">→</span>
                <span class="text-text">AI Tools Lab</span>
            </div>

            <h1 class="mb-8">
                <span class="scattered-letters">
                    <span>A</span><span>I</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>T</span><span>o</span><span>o</span><span>l</span><span>s</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>L</span><span>a</span><span>b</span>
                </span>
            </h1>
            <p class="text-xl md:text-2xl mb-12 max-w-2xl mx-auto">
                Experimental AI tools and applications showcasing the future of observability and developer productivity.
            </p>
        </div>
    </section>

    <!-- Overview Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <div class="grid md:grid-cols-2 gap-16 items-center mb-20">
                <div>
                    <h2 class="mb-8 gradient-text">Experimentation and Learning</h2>
                    <p class="mb-6">
                        AI Tools Lab consists of 15-20 minute recorded technical demonstrations of hands-on (early or first) experiences with AI-related tooling
                        for developers. Each episode explores different aspects of AI tools and their practical applications in software development.
                    </p>
                    <p class="mb-6">
                        All episodes are now available on the <a
                            href="https://youtube.com/@datadogcommunity"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="gradient-text hover:underline">Datadog Community YouTube channel</a
                        >.
                    </p>
                    <p>Subscribe to stay updated on new episodes and explore the latest AI tools and development practices.</p>
                </div>
                <div class="relative">
                    <div class="w-full aspect-video bg-gradient-to-br from-primary/20 to-secondary/20 rounded-2xl overflow-hidden shadow-xl">
                        <iframe
                            class="w-full h-full"
                            src="https://www.youtube.com/embed/videoseries?list=PLVOmGuoGYFgr5lvPwWpsEFm-QU_FvxzJ0"
                            title="AI Tools Lab Playlist"
                            aria-label="AI Tools Lab - Technical demonstrations and educational content about AI development tools and best practices"
                            style="border: none;"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- AI Tools Lab Shorts Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <div class="flex flex-col md:flex-row gap-8 items-center justify-center">
                <!-- Animated Logo -->
                <div class="flex-1 max-w-md h-[640px] bg-gradient-to-br from-primary/20 to-secondary/20 rounded-2xl overflow-hidden shadow-xl flex items-center justify-center">
                    <video
                        autoplay
                        loop
                        muted
                        playsinline
                        class="w-full h-full object-cover"
                    >
                        <source src="/images/AITL_Stinger.mp4" type="video/mp4" />
                        Your browser does not support the video tag.
                    </video>
                </div>
                <!-- YouTube Shorts -->
                <div class="w-full max-w-sm h-[640px] bg-gradient-to-br from-primary/20 to-secondary/20 rounded-2xl overflow-hidden shadow-xl">
                    <iframe
                        class="w-full h-full"
                        src="https://www.youtube.com/embed/videoseries?list=PLjR8CqndeyMpWN93WBE4oDLk1LveBa2sJ"
                        title="AI Tools Lab Shorts Playlist"
                        aria-label="AI Tools Lab Shorts - Quick tips and short-form educational content about AI development tools"
                        style="border: none;"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
                    ></iframe>
                </div>
            </div>
        </div>
    </section>

    <!-- Research Areas Section -->
    <section class="section">
    <div class="max-w-6xl mx-auto">
        <h2 class="text-center mb-16">
            <span class="scattered-letters">
                <span>R</span><span>e</span><span>s</span><span>e</span><span>a</span><span>r</span><span>c</span><span>h</span>
            </span>
            <br />
            <span class="scattered-letters">
                <span>A</span><span>r</span><span>e</span><span>a</span><span>s</span>
            </span>
        </h2>
        <div class="grid md:grid-cols-3 gap-8">
            <div class="project-card">
                <div class="text-4xl mb-4 gradient-text">🧠</div>
                <h3 class="mb-4 gradient-text">Machine Learning</h3>
                <p class="mb-4">Advanced ML algorithms for pattern recognition, anomaly detection, and predictive analytics in observability data.</p>
            </div>

            <div class="project-card">
                <div class="text-4xl mb-4 gradient-text-secondary">💬</div>
                <h3 class="mb-4 gradient-text-secondary">Natural Language Processing</h3>
                <p class="mb-4">NLP techniques for log analysis, incident summarization, and conversational interfaces for monitoring tools.</p>
            </div>

            <div class="project-card">
                <div class="text-4xl mb-4 gradient-text">🔮</div>
                <h3 class="mb-4 gradient-text">Predictive Analytics</h3>
                <p class="mb-4">Forecasting models for capacity planning, performance optimization, and proactive incident prevention.</p>
            </div>
        </div>
    </div>
    </section>

    <!-- CTA Section -->
    <section class="section">
    <div class="max-w-4xl mx-auto text-center">
        <h2 class="mb-8 gradient-text">Watch AI Tools Lab Episodes</h2>
        <p class="text-xl mb-12">
            Subscribe to the Datadog Community YouTube channel to stay updated on new episodes and explore the latest AI tools and development practices.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
            <a href="https://youtube.com/@datadogcommunity" target="_blank" rel="noopener noreferrer" class="btn btn-lg">Visit YouTube Channel</a>
            <a href="/projects" class="btn btn-lg btn-outline">Back to Datadog</a>
        </div>

        <!-- Social Links -->
        <div class="border-t border-gray-800 pt-12">
            <h3 class="mb-6 gradient-text-secondary">Follow AI Tools Lab</h3>
            <div class="flex flex-wrap justify-center gap-6">
                <a
                    href="https://youtube.com/@datadogcommunity"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-text-muted hover:text-primary transition-colors"
                >
                    📺 Datadog Community YouTube
                </a>
                <a href="https://github.com/jasonhand" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-secondary transition-colors">
                    💻 GitHub
                </a>
                <a
                    href="https://www.tiktok.com/@jason.hand"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-text-muted hover:text-accent transition-colors"
                >
                    🎵 TikTok
                </a>
                <a
                    href="https://www.linkedin.com/in/jasonhand24"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-text-muted hover:text-primary transition-colors"
                >
                    💼 LinkedIn
                </a>
            </div>
        </div>
    </div>
</section>
