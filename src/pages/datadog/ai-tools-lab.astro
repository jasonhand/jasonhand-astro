---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="AI Tools Lab - Datadog - Jason Hand">
    <!-- Hero Section -->
    <section class="section-hero">
        <div class="max-w-4xl mx-auto text-center">
            <!-- Breadcrumb -->
            <div class="mb-6">
                <a href="/projects" class="text-text-muted hover:text-primary transition-colors">Datadog</a>
                <span class="text-text-muted mx-2">→</span>
                <span class="text-text">AI Tools Lab</span>
            </div>

            <h1 class="mb-8">
                <span class="scattered-letters">
                    <span>A</span><span>I</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>T</span><span>o</span><span>o</span><span>l</span><span>s</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>L</span><span>a</span><span>b</span>
                </span>
            </h1>
            <p class="text-xl md:text-2xl mb-12 max-w-2xl mx-auto">
                Experimental AI tools and applications showcasing the future of observability and developer productivity.
            </p>
        </div>
    </section>

    <!-- Overview Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <div class="grid md:grid-cols-2 gap-16 items-center mb-20">
                <div>
                    <h2 class="mb-8 gradient-text">Innovation Lab</h2>
                    <p class="mb-6">
                        AI Tools Lab consists of 15-20 minute recorded technical demonstrations of hands-on (early or first) experiences with AI-related tooling
                        for developers. Each episode explores different aspects of AI tools and their practical applications in software development.
                    </p>
                    Visit <a href="https://ai-tools-lab.com" target="_blank" rel="noopener noreferrer" class="gradient-text hover:underline">ai-tools-lab.com</a
                    > to learn more.
                </div>
            </div>
            <div class="relative">
                <div class="w-full h-96 bg-gradient-to-br from-primary/20 to-secondary/20 rounded-2xl flex items-center justify-center">
                    <span class="text-6xl gradient-text">🧪</span>
                </div>
            </div>
        </div>
    </section>
</Layout>

<!-- Recent Episodes Section -->
<section class="section">
    <div class="max-w-6xl mx-auto">
        <h2 class="text-center mb-16">
            <span class="scattered-letters">
                <span>R</span><span>e</span><span>c</span><span>e</span><span>n</span><span>t</span>
            </span>
            <br />
            <span class="scattered-letters">
                <span>E</span><span>p</span><span>i</span><span>s</span><span>o</span><span>d</span><span>e</span><span>s</span>
            </span>
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
            <!-- Episode 32 -->
            <div class="project-card">
                <div class="mb-4">
                    <div class="w-full h-48 bg-gradient-to-br from-primary/30 to-secondary/30 rounded-lg flex items-center justify-center">
                        <span class="text-4xl">🎯</span>
                    </div>
                </div>
                <h3 class="mb-4 gradient-text">Claude Code findings with Rust and TypeScript through Ray Tracing projects</h3>
                <p class="mb-4 text-text-muted">Episode 32 • June 11, 2025 • Jason Hand, Scott Gerring</p>
                <p class="mb-6">
                    In this candid engineering chat, Datadog developer advocate Scott Gerring walks Jason Hand through his latest experiments with Anthropic's
                    Claude Code assistant. Gerring shows off a ray-traced teapot scene that Claude generated almost entirely on its own.
                </p>
                <div class="flex flex-wrap gap-2 mb-4">
                    <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">claude-code</span>
                    <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">typescript</span>
                    <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">rust</span>
                </div>
                <div class="flex flex-col sm:flex-row gap-4">
                    <a href="https://ai-tools-lab.com" target="_blank" rel="noopener noreferrer" class="btn">Watch Episode</a>
                    <a href="#" class="btn btn-outline">Learn More</a>
                </div>
            </div>

            <!-- Episode 31 -->
            <div class="project-card">
                <div class="mb-4">
                    <div class="w-full h-48 bg-gradient-to-br from-secondary/30 to-accent/30 rounded-lg flex items-center justify-center">
                        <span class="text-4xl">⚡</span>
                    </div>
                </div>
                <h3 class="mb-4 gradient-text-secondary">Building client-side URL-based state apps using Claude 4 and Lovable</h3>
                <p class="mb-4 text-text-muted">Episode 31 • June 4, 2025 • Jason Hand, Ryan MacLean</p>
                <p class="mb-6">
                    Jason Hand and Ryan MacLean chat and demonstrate practical uses of Claude and Lovable in coming up with and building on ideas very quickly
                    .. daily .. almost as a personal challenge.
                </p>
                <div class="flex flex-wrap gap-2 mb-4">
                    <span class="px-3 py-1 bg-secondary/20 text-secondary rounded-full text-sm">claude</span>
                    <span class="px-3 py-1 bg-secondary/20 text-secondary rounded-full text-sm">lovable</span>
                    <span class="px-3 py-1 bg-secondary/20 text-secondary rounded-full text-sm">ai-development</span>
                </div>
                <div class="flex flex-col sm:flex-row gap-4">
                    <a href="https://ai-tools-lab.com" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Watch Episode</a>
                    <a href="#" class="btn btn-outline">Learn More</a>
                </div>
            </div>

            <!-- Episode 30 -->
            <div class="project-card">
                <div class="mb-4">
                    <div class="w-full h-48 bg-gradient-to-br from-accent/30 to-primary/30 rounded-lg flex items-center justify-center">
                        <span class="text-4xl">🔧</span>
                    </div>
                </div>
                <h3 class="mb-4 gradient-text">Maximizing AI with Cursor: Building MCP Servers for Seamless Workflow</h3>
                <p class="mb-4 text-text-muted">Episode 30 • May 23, 2025 • Whitney Lee</p>
                <p class="mb-6">
                    Whitney Lee shares her journey of building an MCP (Model Context Protocol) server designed to automate engineering journal entries. Learn
                    how she evolved from experimenting with basic Cursor capabilities to developing a robust tool.
                </p>
                <div class="flex flex-wrap gap-2 mb-4">
                    <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-sm">mcp</span>
                    <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-sm">cursor</span>
                    <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-sm">ai-development</span>
                </div>
                <div class="flex flex-col sm:flex-row gap-4">
                    <a href="https://ai-tools-lab.com" target="_blank" rel="noopener noreferrer" class="btn">Watch Episode</a>
                    <a href="#" class="btn btn-outline">Learn More</a>
                </div>
            </div>

            <!-- Episode 29 -->
            <div class="project-card">
                <div class="mb-4">
                    <div class="w-full h-48 bg-gradient-to-br from-primary/30 to-accent/30 rounded-lg flex items-center justify-center">
                        <span class="text-4xl">🌀</span>
                    </div>
                </div>
                <h3 class="mb-4 gradient-text-secondary">Building a Lissajous Animation Using Gemini 2.5 Pro</h3>
                <p class="mb-4 text-text-muted">Episode 29 • May 12, 2025 • Jason Hand, Ryan MacLean</p>
                <p class="mb-6">
                    Jason Hand and Ryan MacLean explore the capabilities of Gemini 2.5 Pro, demonstrating its impressive features through hands-on examples
                    including creating interactive mathematical visualizations.
                </p>
                <div class="flex flex-wrap gap-2 mb-4">
                    <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">gemini</span>
                    <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">ai-development</span>
                    <span class="px-3 py-1 bg-primary/20 text-primary rounded-full text-sm">coding</span>
                </div>
                <div class="flex flex-col sm:flex-row gap-4">
                    <a href="https://ai-tools-lab.com" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Watch Episode</a>
                    <a href="#" class="btn btn-outline">Learn More</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Research Areas Section -->
<section class="section">
    <div class="max-w-6xl mx-auto">
        <h2 class="text-center mb-16">
            <span class="scattered-letters">
                <span>R</span><span>e</span><span>s</span><span>e</span><span>a</span><span>r</span><span>c</span><span>h</span>
            </span>
            <br />
            <span class="scattered-letters">
                <span>A</span><span>r</span><span>e</span><span>a</span><span>s</span>
            </span>
        </h2>
        <div class="grid md:grid-cols-3 gap-8">
            <div class="project-card">
                <div class="text-4xl mb-4 gradient-text">🧠</div>
                <h3 class="mb-4 gradient-text">Machine Learning</h3>
                <p class="mb-4">Advanced ML algorithms for pattern recognition, anomaly detection, and predictive analytics in observability data.</p>
            </div>

            <div class="project-card">
                <div class="text-4xl mb-4 gradient-text-secondary">💬</div>
                <h3 class="mb-4 gradient-text-secondary">Natural Language Processing</h3>
                <p class="mb-4">NLP techniques for log analysis, incident summarization, and conversational interfaces for monitoring tools.</p>
            </div>

            <div class="project-card">
                <div class="text-4xl mb-4 gradient-text">🔮</div>
                <h3 class="mb-4 gradient-text">Predictive Analytics</h3>
                <p class="mb-4">Forecasting models for capacity planning, performance optimization, and proactive incident prevention.</p>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="section">
    <div class="max-w-4xl mx-auto text-center">
        <h2 class="mb-8 gradient-text">Explore the Lab</h2>
        <p class="text-xl mb-12">Visit our experimental platform to try cutting-edge AI tools and contribute to the future of observability.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
            <a href="https://ai-tools-lab.com" target="_blank" rel="noopener noreferrer" class="btn btn-lg">Visit AI Tools Lab</a>
            <a href="/projects" class="btn btn-lg btn-outline">Back to Datadog</a>
        </div>

        <!-- Social Links -->
        <div class="border-t border-gray-800 pt-12">
            <h3 class="mb-6 gradient-text-secondary">Follow AI Tools Lab</h3>
            <div class="flex flex-wrap justify-center gap-6">
                <a href="https://youtube.com/@jhand" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-primary transition-colors">
                    📺 YouTube
                </a>
                <a href="https://github.com/jasonhand" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-secondary transition-colors">
                    💻 GitHub
                </a>
                <a
                    href="https://www.tiktok.com/@jason.hand"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-text-muted hover:text-accent transition-colors"
                >
                    🎵 TikTok
                </a>
                <a
                    href="https://www.linkedin.com/in/jasonhand24"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-text-muted hover:text-primary transition-colors"
                >
                    💼 LinkedIn
                </a>
            </div>
        </div>
    </div>
</section>
