---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="DASH - Datadog - Jason Hand">
    <!-- Hero Section -->
    <section class="section-hero">
        <div class="max-w-4xl mx-auto text-center">
            <!-- Breadcrumb -->
            <div class="mb-6">
                <a href="/projects" class="text-text-muted hover:text-primary transition-colors">Datadog</a>
                <span class="text-text-muted mx-2">→</span>
                <span class="text-text">DASH</span>
            </div>

            <h1 class="mb-8">
                <span class="scattered-letters">
                    <span>D</span><span>A</span><span>S</span><span>H</span>
                </span>
            </h1>
            <p class="text-xl md:text-2xl mb-12 max-w-2xl mx-auto">
                Datadog's annual conference where observability, security, and AI converge. Join thousands of builders, engineers, and security experts in New York City.
            </p>
        </div>
    </section>

    <!-- Conference Screenshot Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <div class="mb-12">
                <img
                    src="/images/screenshots/dash-conference.png"
                    alt="DASH Conference 2026"
                    class="w-full rounded-2xl shadow-2xl"
                />
            </div>
        </div>
    </section>

    <!-- Overview Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <div class="grid md:grid-cols-2 gap-16 items-center mb-20">
                <div>
                    <h2 class="mb-8 gradient-text">Observe • Secure • Act</h2>
                    <p class="mb-6">
                        DASH is Datadog's flagship annual conference bringing together thousands of builders, engineers, and security experts from around the world for two days of learning and inspiration in New York City.
                    </p>
                    <p class="mb-6">
                        Discover how observability, security, and AI are redefining how we build and scale what's next. The conference features keynotes from industry leaders, hands-on technical sessions, workshops, product announcements, and unparalleled networking opportunities.
                    </p>
                    <p class="mb-6">
                        As a key contributor to DASH, I help shape the content, deliver presentations, and engage with the community to advance the state of observability and modern infrastructure practices.
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a href="https://www.dashcon.io/" target="_blank" rel="noopener noreferrer" class="btn btn-lg">
                            Visit DASH Conference
                        </a>
                        <a href="https://www.dashcon.io/on-demand" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-outline">
                            Watch 2025 Sessions
                        </a>
                    </div>
                </div>
                <div class="relative">
                    <div class="w-full h-96 bg-gradient-to-br from-primary/20 to-secondary/20 rounded-2xl flex items-center justify-center">
                        <span class="text-6xl gradient-text">🏆</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- DASH 2026 Details -->
    <section class="section">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="mb-8 gradient-text">DASH 2026</h2>
            <div class="project-card mb-12">
                <div class="grid md:grid-cols-2 gap-8 items-center">
                    <div class="text-left">
                        <h3 class="mb-4 gradient-text-secondary text-2xl">Save the Date</h3>
                        <p class="mb-4 text-2xl font-bold">June 9-10, 2026</p>
                        <p class="mb-4 text-xl">New York City</p>
                        <p class="mb-6 text-text-muted">Registration opens soon</p>
                        <p class="mb-6">
                            Two days of learning, networking, and innovation featuring the latest in observability, security, and AI-powered infrastructure.
                        </p>
                        <a href="https://www.dashcon.io/save-the-date/" target="_blank" rel="noopener noreferrer" class="btn">
                            Get Notified
                        </a>
                    </div>
                    <div>
                        <div class="w-full h-64 bg-gradient-to-br from-secondary/30 to-accent/30 rounded-lg flex items-center justify-center">
                            <span class="text-6xl">📅</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Conference Highlights Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-16">
                <span class="scattered-letters">
                    <span>W</span><span>h</span><span>y</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>A</span><span>t</span><span>t</span><span>e</span><span>n</span><span>d</span><span>?</span>
                </span>
            </h2>
            <div class="grid md:grid-cols-2 gap-8">
                <!-- Product Announcements -->
                <div class="project-card">
                    <div class="mb-4">
                        <div class="w-full h-48 bg-gradient-to-br from-primary/30 to-secondary/30 rounded-lg flex items-center justify-center">
                            <span class="text-4xl">🚀</span>
                        </div>
                    </div>
                    <h3 class="mb-4 gradient-text">Be the First to Know</h3>
                    <p class="mb-4 text-text-muted">Product Launches • Innovation • Future Vision</p>
                    <p class="mb-6">Hear about the latest products and releases from Datadog. Get exclusive first looks at new features and capabilities.</p>
                </div>

                <!-- Hands-on Training -->
                <div class="project-card">
                    <div class="mb-4">
                        <div class="w-full h-48 bg-gradient-to-br from-secondary/30 to-accent/30 rounded-lg flex items-center justify-center">
                            <span class="text-4xl">🛠️</span>
                        </div>
                    </div>
                    <h3 class="mb-4 gradient-text-secondary">Get Hands On</h3>
                    <p class="mb-4 text-text-muted">Workshops • Training • Expert Guidance</p>
                    <p class="mb-6">Find hands-on training at all levels of experience with Datadog experts. Build real solutions and gain practical skills.</p>
                </div>

                <!-- Learning from Peers -->
                <div class="project-card">
                    <div class="mb-4">
                        <div class="w-full h-48 bg-gradient-to-br from-accent/30 to-primary/30 rounded-lg flex items-center justify-center">
                            <span class="text-4xl">🎓</span>
                        </div>
                    </div>
                    <h3 class="mb-4 gradient-text">Learn from Peers</h3>
                    <p class="mb-4 text-text-muted">Breakout Sessions • Case Studies • Best Practices</p>
                    <p class="mb-6">Unlock inspiration from leading industry experts through breakout sessions and networking events.</p>
                </div>

                <!-- Partners & Expo -->
                <div class="project-card">
                    <div class="mb-4">
                        <div class="w-full h-48 bg-gradient-to-br from-primary/30 to-accent/30 rounded-lg flex items-center justify-center">
                            <span class="text-4xl">🤝</span>
                        </div>
                    </div>
                    <h3 class="mb-4 gradient-text-secondary">Meet with Partners</h3>
                    <p class="mb-4 text-text-muted">Expo • Technology Partners • Networking</p>
                    <p class="mb-6">Explore the latest offerings from top companies partnered with Datadog. Connect with sponsors and ecosystem partners.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Call for Proposals Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <div class="grid md:grid-cols-2 gap-16 items-center">
                <div class="relative">
                    <div class="w-full h-96 bg-gradient-to-br from-secondary/20 to-primary/20 rounded-2xl flex items-center justify-center">
                        <span class="text-6xl gradient-text-secondary">📢</span>
                    </div>
                </div>
                <div>
                    <h2 class="mb-8 gradient-text">Share Your Story at DASH</h2>
                    <p class="mb-6 text-lg">
                        If you have a story of speed, reliability, scalability, and security, we want to hear it! The call for proposals is open for DASH 2026.
                    </p>
                    <p class="mb-6 text-text-muted">
                        <strong>CFP Deadline:</strong> March 4th, 2026
                    </p>
                    <p class="mb-8">
                        Share your experiences, challenges, and solutions with the global observability community. Present your innovative approaches to monitoring, security, and AI-powered infrastructure.
                    </p>
                    <a href="https://www.dashcon.io/cfp/" target="_blank" rel="noopener noreferrer" class="btn btn-lg">
                        Submit Your Proposal
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Speakers Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-16">
                <span class="scattered-letters">
                    <span>2</span><span>0</span><span>2</span><span>5</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>F</span><span>e</span><span>a</span><span>t</span><span>u</span><span>r</span><span>e</span><span>d</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>S</span><span>p</span><span>e</span><span>a</span><span>k</span><span>e</span><span>r</span><span>s</span>
                </span>
            </h2>
            <div class="grid md:grid-cols-3 gap-8 mb-12">
                <!-- Kumail Nanjiani -->
                <div class="project-card text-center">
                    <div class="text-5xl mb-4">🎭</div>
                    <h3 class="mb-2 gradient-text">Kumail Nanjiani</h3>
                    <p class="text-sm text-text-muted mb-4">Writer, Actor & Comedian</p>
                    <p class="text-sm">Oscar and Emmy-nominated actor known for The Big Sick, Silicon Valley, and The Eternals.</p>
                </div>

                <!-- Alexis Lê-Quôc -->
                <div class="project-card text-center">
                    <div class="text-5xl mb-4">👨‍💻</div>
                    <h3 class="mb-2 gradient-text-secondary">Alexis Lê-Quôc</h3>
                    <p class="text-sm text-text-muted mb-4">CTO & Co-founder, Datadog</p>
                    <p class="text-sm">Leading Datadog's technical vision and product innovation.</p>
                </div>

                <!-- Yanbing Li -->
                <div class="project-card text-center">
                    <div class="text-5xl mb-4">🎯</div>
                    <h3 class="mb-2 gradient-text">Yanbing Li</h3>
                    <p class="text-sm text-text-muted mb-4">Chief Product Officer, Datadog</p>
                    <p class="text-sm">Driving product strategy and development at Datadog.</p>
                </div>

                <!-- Santiago Gómez Sáez -->
                <div class="project-card text-center">
                    <div class="text-5xl mb-4">🚗</div>
                    <h3 class="mb-2 gradient-text-secondary">Santiago Gómez Sáez</h3>
                    <p class="text-sm text-text-muted mb-4">Principal Cloud Architect, Volkswagen</p>
                    <p class="text-sm">Leading cloud architecture initiatives at dx.one - Volkswagen Group.</p>
                </div>

                <!-- Bhawna Singh -->
                <div class="project-card text-center">
                    <div class="text-5xl mb-4">🔐</div>
                    <h3 class="mb-2 gradient-text">Bhawna Singh</h3>
                    <p class="text-sm text-text-muted mb-4">CTO, Okta</p>
                    <p class="text-sm">Leading technology and engineering at Okta.</p>
                </div>

                <!-- Arthur Patterson -->
                <div class="project-card text-center">
                    <div class="text-5xl mb-4">🏠</div>
                    <h3 class="mb-2 gradient-text-secondary">Arthur Patterson</h3>
                    <p class="text-sm text-text-muted mb-4">Senior Engineering Manager, Redfin</p>
                    <p class="text-sm">Engineering leadership at Redfin's technology platform.</p>
                </div>
            </div>
            <div class="text-center">
                <a href="https://www.dashcon.io/speakers" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-outline">
                    View All Speakers
                </a>
            </div>
        </div>
    </section>

    <!-- My Contributions Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-16">
                <span class="scattered-letters">
                    <span>M</span><span>y</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>C</span><span>o</span><span>n</span><span>t</span><span>r</span><span>i</span><span>b</span><span>u</span><span>t</span><span>i</span
                    ><span>o</span><span>n</span><span>s</span>
                </span>
            </h2>
            <div class="grid md:grid-cols-3 gap-8">
                <div class="project-card">
                    <div class="text-4xl mb-4 gradient-text">🎤</div>
                    <h3 class="mb-4 gradient-text">Speaking</h3>
                    <p class="mb-4">Delivering technical presentations on AI-powered observability, modern monitoring practices, and developer experience.</p>
                </div>

                <div class="project-card">
                    <div class="text-4xl mb-4 gradient-text-secondary">📋</div>
                    <h3 class="mb-4 gradient-text-secondary">Content Planning</h3>
                    <p class="mb-4">Helping shape the conference agenda, selecting speakers, and ensuring high-quality, relevant content for attendees.</p>
                </div>

                <div class="project-card">
                    <div class="text-4xl mb-4 gradient-text">👥</div>
                    <h3 class="mb-4 gradient-text">Community Engagement</h3>
                    <p class="mb-4">Facilitating discussions, moderating sessions, and connecting with community members to foster collaboration.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="section">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="mb-8 gradient-text">Join the DASH Community</h2>
            <p class="text-xl mb-12">Be part of the premier observability conference and connect with thousands of engineers and technology leaders.</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
                <a href="https://www.dashcon.io/" target="_blank" rel="noopener noreferrer" class="btn btn-lg">
                    Visit dashcon.io
                </a>
                <a href="/projects" class="btn btn-lg btn-outline">Back to Datadog</a>
            </div>

            <!-- Social Links -->
            <div class="border-t border-gray-800 pt-12">
                <h3 class="mb-6 gradient-text-secondary">Follow DASH Updates</h3>
                <div class="flex flex-wrap justify-center gap-6">
                    <a href="https://x.com/dashconio/" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-primary transition-colors">
                        𝕏 Twitter/X
                    </a>
                    <a
                        href="https://www.linkedin.com/company/datadog/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-secondary transition-colors"
                    >
                        💼 LinkedIn
                    </a>
                    <a
                        href="https://www.facebook.com/datadoghq/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-accent transition-colors"
                    >
                        👍 Facebook
                    </a>
                    <a href="https://youtube.com/@jhand" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-primary transition-colors">
                        📺 YouTube
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>
