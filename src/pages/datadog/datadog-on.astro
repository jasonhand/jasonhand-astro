---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Datadog On - Datadog - Jason Hand">
    <!-- Hero Section -->
    <section class="section-hero">
        <div class="max-w-4xl mx-auto text-center">
            <!-- Breadcrumb -->
            <div class="mb-6">
                <a href="/projects" class="text-text-muted hover:text-primary transition-colors">Datadog</a>
                <span class="text-text-muted mx-2">→</span>
                <span class="text-text">Datadog On</span>
            </div>

            <h1 class="mb-8">
                <span class="scattered-letters">
                    <span>D</span><span>a</span><span>t</span><span>a</span><span>d</span><span>o</span><span>g</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>O</span><span>n</span><span>.</span><span>.</span><span>.</span>
                </span>
            </h1>
            <p class="text-xl md:text-2xl mb-12 max-w-2xl mx-auto">
                A conversational series featuring Datadog engineers sharing real-world experiences building scalable, distributed systems in the cloud.
            </p>
        </div>
    </section>

    <!-- Overview Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <div class="grid md:grid-cols-2 gap-16 items-center mb-20">
                <div>
                    <h2 class="mb-8 gradient-text">Let's Learn Together</h2>
                    <p class="mb-6">
                        In the process of building a monitoring and analytics platform that <strong>ingests trillions of data points a day</strong>, Datadog has learned many lessons about scalable, distributed systems in the cloud.
                    </p>
                    <p class="mb-6">
                        Each episode offers a conversation with the engineers who build Datadog. They share real-world experiences architecting, building, operating, and monitoring modern systems—giving you actionable information you can apply at your organization.
                    </p>
                    <p class="mb-6">
                        With plenty of time left for Q&A, we invite you to join the discussion and learn alongside the community.
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a href="https://datadogon.datadoghq.com/" target="_blank" rel="noopener noreferrer" class="btn btn-lg">
                            Visit Datadog On
                        </a>
                        <a href="https://datadogon.datadoghq.com/episodes" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-outline">
                            View Episodes
                        </a>
                    </div>
                </div>
                <div class="relative">
                    <div class="w-full h-96 bg-gradient-to-br from-secondary/20 to-accent/20 rounded-2xl flex items-center justify-center">
                        <span class="text-6xl gradient-text-secondary">📺</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Episodes Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-16">
                <span class="scattered-letters">
                    <span>F</span><span>e</span><span>a</span><span>t</span><span>u</span><span>r</span><span>e</span><span>d</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>E</span><span>p</span><span>i</span><span>s</span><span>o</span><span>d</span><span>e</span><span>s</span>
                </span>
            </h2>

            <!-- Episode: Evaluation From Chatbots to Autonomous Agents -->
            <div class="project-card mb-12">
                <div class="grid md:grid-cols-2 gap-8 items-start">
                    <div>
                        <h3 class="mb-4 gradient-text text-2xl">Evaluation From Chatbots to Autonomous Agents</h3>
                        <p class="mb-6 text-lg">
                            Explore the evolution from simple chatbots to sophisticated autonomous agents, and learn about the critical role of evaluation in building reliable AI systems.
                        </p>
                        <p class="mb-6">
                            This episode dives deep into the practical challenges of building AI-powered systems, including evaluation strategies, testing methodologies, and best practices for deploying autonomous agents in production environments.
                        </p>
                        <div class="flex flex-col sm:flex-row gap-4">
                            <a href="https://youtu.be/7OsdkuezlEY" target="_blank" rel="noopener noreferrer" class="btn">
                                Watch on YouTube
                            </a>
                            <a href="https://datadogon.datadoghq.com/episodes" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
                                More Episodes
                            </a>
                        </div>
                    </div>
                    <div>
                        <div class="w-full aspect-video rounded-lg overflow-hidden shadow-2xl">
                            <iframe
                                class="w-full h-full"
                                src="https://www.youtube.com/embed/7OsdkuezlEY"
                                title="Evaluation From Chatbots to Autonomous Agents"
                                style="border: none;"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allowfullscreen
                            ></iframe>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Episode: Datadog On Data Science -->
            <div class="project-card">
                <div class="grid md:grid-cols-2 gap-8 items-start">
                    <div>
                        <h3 class="mb-4 gradient-text-secondary text-2xl">Datadog On Data Science</h3>
                        <p class="mb-6 text-lg">
                            Discover how data science powers modern observability and monitoring at scale. Learn techniques for analyzing massive datasets and extracting meaningful insights.
                        </p>
                        <p class="mb-6">
                            This episode explores practical data science applications in observability, including anomaly detection, predictive analytics, trend analysis, and machine learning techniques for monitoring systems that process trillions of data points daily.
                        </p>
                        <div class="flex flex-col sm:flex-row gap-4">
                            <a href="https://youtu.be/imDWRTeQFGY" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                                Watch on YouTube
                            </a>
                            <a href="https://datadogon.datadoghq.com/episodes" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
                                More Episodes
                            </a>
                        </div>
                    </div>
                    <div>
                        <div class="w-full aspect-video rounded-lg overflow-hidden shadow-2xl">
                            <iframe
                                class="w-full h-full"
                                src="https://www.youtube.com/embed/imDWRTeQFGY"
                                title="Datadog On Data Science"
                                style="border: none;"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allowfullscreen
                            ></iframe>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Topics Covered Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-16">
                <span class="scattered-letters">
                    <span>T</span><span>o</span><span>p</span><span>i</span><span>c</span><span>s</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>C</span><span>o</span><span>v</span><span>e</span><span>r</span><span>e</span><span>d</span>
                </span>
            </h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Storage & Backend -->
                <div class="project-card">
                    <div class="text-4xl mb-4 gradient-text">💾</div>
                    <h3 class="mb-4 gradient-text">Storage & Backend</h3>
                    <p class="mb-4">Deep dives into distributed storage systems, data architecture, and backend infrastructure at scale.</p>
                </div>

                <!-- Reliability & Performance -->
                <div class="project-card">
                    <div class="text-4xl mb-4 gradient-text-secondary">⚡</div>
                    <h3 class="mb-4 gradient-text-secondary">Reliability & Performance</h3>
                    <p class="mb-4">Building resilient systems that perform at scale with lessons from running production infrastructure.</p>
                </div>

                <!-- Security -->
                <div class="project-card">
                    <div class="text-4xl mb-4 gradient-text">🔒</div>
                    <h3 class="mb-4 gradient-text">Security</h3>
                    <p class="mb-4">Cloud security practices, threat detection, and building secure distributed systems.</p>
                </div>

                <!-- Data Science & ML -->
                <div class="project-card">
                    <div class="text-4xl mb-4 gradient-text-secondary">🤖</div>
                    <h3 class="mb-4 gradient-text-secondary">Machine Learning</h3>
                    <p class="mb-4">Applying ML to observability data, anomaly detection, and intelligent automation.</p>
                </div>

                <!-- Frontend & UX -->
                <div class="project-card">
                    <div class="text-4xl mb-4 gradient-text">🎨</div>
                    <h3 class="mb-4 gradient-text">Frontend & UX</h3>
                    <p class="mb-4">Building performant, scalable frontend applications and delivering great user experiences.</p>
                </div>

                <!-- Mobile -->
                <div class="project-card">
                    <div class="text-4xl mb-4 gradient-text-secondary">📱</div>
                    <h3 class="mb-4 gradient-text-secondary">Mobile Technologies</h3>
                    <p class="mb-4">Mobile development, monitoring mobile applications, and mobile-first approaches.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Recent Episodes Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-16">
                <span class="scattered-letters">
                    <span>R</span><span>e</span><span>c</span><span>e</span><span>n</span><span>t</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>E</span><span>p</span><span>i</span><span>s</span><span>o</span><span>d</span><span>e</span><span>s</span>
                </span>
            </h2>
            <div class="grid md:grid-cols-3 gap-8 mb-12">
                <!-- Apache Iceberg -->
                <div class="project-card">
                    <div class="mb-4">
                        <div class="w-full h-48 bg-gradient-to-br from-primary/30 to-secondary/30 rounded-lg flex items-center justify-center">
                            <span class="text-4xl">🏔️</span>
                        </div>
                    </div>
                    <h3 class="mb-4 gradient-text">Datadog on Apache Iceberg</h3>
                    <p class="mb-3 text-sm text-text-muted">November 20, 2025</p>
                    <p class="mb-4 text-sm">Alessandro Nori, Leopold Boudard, and Ara Pulido discuss Apache Iceberg and modern data lake architectures.</p>
                </div>

                <!-- Rust -->
                <div class="project-card">
                    <div class="mb-4">
                        <div class="w-full h-48 bg-gradient-to-br from-secondary/30 to-accent/30 rounded-lg flex items-center justify-center">
                            <span class="text-4xl">🦀</span>
                        </div>
                    </div>
                    <h3 class="mb-4 gradient-text-secondary">Return of Rust</h3>
                    <p class="mb-3 text-sm text-text-muted">October 29, 2025</p>
                    <p class="mb-4 text-sm">Duarte Nunes, Toby Lawrence, and Scott Gerring explore Rust programming at Datadog.</p>
                </div>

                <!-- Datadog on Datadog -->
                <div class="project-card">
                    <div class="mb-4">
                        <div class="w-full h-48 bg-gradient-to-br from-accent/30 to-primary/30 rounded-lg flex items-center justify-center">
                            <span class="text-4xl">🐕</span>
                        </div>
                    </div>
                    <h3 class="mb-4 gradient-text">Datadog on Datadog</h3>
                    <p class="mb-3 text-sm text-text-muted">March 4, 2025</p>
                    <p class="mb-4 text-sm">Kris Kennaway, Angela Beteta, and Ara Pulido discuss how Datadog monitors itself.</p>
                </div>
            </div>
            <div class="text-center">
                <a href="https://datadogon.datadoghq.com/episodes" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-outline">
                    View All Episodes
                </a>
            </div>
        </div>
    </section>

    <!-- Hosts Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-16">
                <span class="scattered-letters">
                    <span>H</span><span>o</span><span>s</span><span>t</span><span>s</span>
                </span>
            </h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Jason Hand -->
                <div class="project-card text-center">
                    <div class="text-5xl mb-4">👨‍💻</div>
                    <h3 class="mb-2 gradient-text">Jason Hand</h3>
                    <p class="text-sm text-text-muted mb-4">Senior Developer Advocate</p>
                    <p class="text-sm">Host of Datadog On, sharing insights on observability, incident management, and developer experience.</p>
                </div>

                <!-- Ara Pulido -->
                <div class="project-card text-center">
                    <div class="text-5xl mb-4">🎤</div>
                    <h3 class="mb-2 gradient-text-secondary">Ara Pulido</h3>
                    <p class="text-sm text-text-muted mb-4">Staff Developer Advocate</p>
                    <p class="text-sm">Regular host bringing deep technical expertise to the series.</p>
                </div>

                <!-- Scott Gerring -->
                <div class="project-card text-center">
                    <div class="text-5xl mb-4">🚀</div>
                    <h3 class="mb-2 gradient-text">Scott Gerring</h3>
                    <p class="text-sm text-text-muted mb-4">Developer Advocate</p>
                    <p class="text-sm">Host focusing on cloud infrastructure and modern development practices.</p>
                </div>

                <!-- Christophe Tafani-Dereeper -->
                <div class="project-card text-center">
                    <div class="text-5xl mb-4">🔐</div>
                    <h3 class="mb-2 gradient-text-secondary">Christophe Tafani-Dereeper</h3>
                    <p class="text-sm text-text-muted mb-4">Cloud Security Researcher</p>
                    <p class="text-sm">Host specializing in cloud security topics and threat detection.</p>
                </div>

                <!-- Juliano Costa -->
                <div class="project-card text-center">
                    <div class="text-5xl mb-4">⚙️</div>
                    <h3 class="mb-2 gradient-text">Juliano Costa</h3>
                    <p class="text-sm text-text-muted mb-4">Developer Advocate</p>
                    <p class="text-sm">Host exploring distributed systems and infrastructure topics.</p>
                </div>

                <!-- Rory McCune -->
                <div class="project-card text-center">
                    <div class="text-5xl mb-4">🛡️</div>
                    <h3 class="mb-2 gradient-text-secondary">Rory McCune</h3>
                    <p class="text-sm text-text-muted mb-4">Senior Security Advocate</p>
                    <p class="text-sm">Host covering security operations and best practices.</p>
                </div>
            </div>
            <div class="text-center mt-12">
                <a href="https://datadogon.datadoghq.com/speakers" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-outline">
                    View All Speakers
                </a>
            </div>
        </div>
    </section>

    <!-- Episode Format Section -->
    <section class="section">
        <div class="max-w-4xl mx-auto">
            <h2 class="text-center mb-12 gradient-text">Episode Format</h2>
            <div class="grid md:grid-cols-2 gap-8">
                <div class="project-card">
                    <div class="text-4xl mb-4 gradient-text">💬</div>
                    <h3 class="mb-4 gradient-text">Conversations</h3>
                    <p>Each episode features candid conversations with Datadog engineers about their experiences building and operating systems at scale.</p>
                </div>

                <div class="project-card">
                    <div class="text-4xl mb-4 gradient-text-secondary">❓</div>
                    <h3 class="mb-4 gradient-text-secondary">Q&A Sessions</h3>
                    <p>Interactive Q&A segments where the community can ask questions and dive deeper into technical topics.</p>
                </div>

                <div class="project-card">
                    <div class="text-4xl mb-4 gradient-text">📚</div>
                    <h3 class="mb-4 gradient-text">Actionable Insights</h3>
                    <p>Real-world experiences and practical knowledge you can apply to your own systems and organizations.</p>
                </div>

                <div class="project-card">
                    <div class="text-4xl mb-4 gradient-text-secondary">🎯</div>
                    <h3 class="mb-4 gradient-text-secondary">Technical Deep Dives</h3>
                    <p>In-depth exploration of specific technologies, architectures, and engineering challenges.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="section">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="mb-8 gradient-text">Join the Datadog On Community</h2>
            <p class="text-xl mb-12">Subscribe to the series and stay updated with the latest episodes covering scalable systems, cloud infrastructure, and modern engineering practices.</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
                <a href="https://datadogon.datadoghq.com/" target="_blank" rel="noopener noreferrer" class="btn btn-lg">
                    Subscribe to Datadog On
                </a>
                <a href="/projects" class="btn btn-lg btn-outline">Back to Datadog</a>
            </div>

            <!-- Social Links -->
            <div class="border-t border-gray-800 pt-12">
                <h3 class="mb-6 gradient-text-secondary">Follow Datadog</h3>
                <div class="flex flex-wrap justify-center gap-6">
                    <a href="https://twitter.com/datadoghq" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-primary transition-colors">
                        𝕏 Twitter/X
                    </a>
                    <a
                        href="https://www.youtube.com/user/DatadogHQ"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-secondary transition-colors"
                    >
                        📺 YouTube
                    </a>
                    <a
                        href="https://www.linkedin.com/company/datadog"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-accent transition-colors"
                    >
                        💼 LinkedIn
                    </a>
                    <a
                        href="https://www.instagram.com/datadoghq/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-primary transition-colors"
                    >
                        📸 Instagram
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>
