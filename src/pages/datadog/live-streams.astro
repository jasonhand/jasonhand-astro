---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Live Streams - Datadog - Jason Hand">
    <!-- Hero Section -->
    <section class="section-hero">
        <div class="max-w-4xl mx-auto text-center">
            <!-- Breadcrumb -->
            <div class="mb-6">
                <a href="/projects" class="text-text-muted hover:text-primary transition-colors">Datadog</a>
                <span class="text-text-muted mx-2">→</span>
                <span class="text-text">Live Streams</span>
            </div>

            <h1 class="mb-8">
                <span class="scattered-letters">
                    <span>L</span><span>i</span><span>v</span><span>e</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>S</span><span>t</span><span>r</span><span>e</span><span>a</span><span>m</span><span>s</span>
                </span>
            </h1>
            <p class="text-xl md:text-2xl mb-12 max-w-2xl mx-auto">
                Interactive live streaming sessions including AI Native DevCon and community-driven content.
            </p>
        </div>
    </section>

    <!-- Overview Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <div class="grid md:grid-cols-2 gap-16 items-center mb-20">
                <div>
                    <h2 class="mb-8 gradient-text">Interactive Content</h2>
                    <p class="mb-6">
                        Our live streaming sessions provide real-time interaction with the community, featuring live coding, Q&A sessions, and collaborative
                        problem-solving.
                    </p>
                    <p class="mb-6">
                        From AI Native DevCon to regular community streams, these sessions offer immediate value and direct engagement with experts and peers.
                    </p>
                    <p>Join us live to participate in discussions, ask questions, and learn alongside a global community of developers and engineers.</p>
                </div>
                <div class="relative">
                    <div class="w-full h-96 bg-gradient-to-br from-accent/20 to-primary/20 rounded-2xl flex items-center justify-center">
                        <span class="text-6xl gradient-text">🔴</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Streams Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-16">
                <span class="scattered-letters">
                    <span>F</span><span>e</span><span>a</span><span>t</span><span>u</span><span>r</span><span>e</span><span>d</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>S</span><span>t</span><span>r</span><span>e</span><span>a</span><span>m</span><span>s</span>
                </span>
            </h2>
            <div class="grid md:grid-cols-2 gap-8">
                <!-- AI Native DevCon -->
                <div class="project-card">
                    <div class="mb-4">
                        <div class="w-full aspect-video bg-gradient-to-br from-primary/30 to-secondary/30 rounded-lg overflow-hidden">
                            <iframe
                                class="w-full h-full"
                                src="https://www.youtube.com/embed/LcsGFQr7vqU"
                                title="AI Native DevCon"
                                style="border: none;"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
                            ></iframe>
                        </div>
                    </div>
                    <h3 class="mb-4 gradient-text">AI Native DevCon</h3>
                    <p class="mb-4 text-text-muted">AI Development • Live Coding • Community • Innovation</p>
                    <p class="mb-6">
                        Interactive conference-style streams focusing on AI-native development practices, featuring live coding sessions and expert discussions.
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a 
                            href="https://youtu.be/LcsGFQr7vqU" 
                            target="_blank" 
                            rel="noopener noreferrer" 
                            class="btn btn-outline"
                        >
                            Watch on YouTube
                        </a>
                    </div>
                </div>

                <!-- AI Observability Deep Dive -->
                <div class="project-card">
                    <div class="mb-4">
                        <div class="w-full aspect-video bg-gradient-to-br from-primary/30 to-secondary/30 rounded-lg overflow-hidden">
                            <iframe
                                class="w-full h-full"
                                src="https://www.youtube.com/embed/W8ShFoa7ALY"
                                title="AI Observability Deep Dive"
                                style="border: none;"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
                            ></iframe>
                        </div>
                    </div>
                    <h3 class="mb-4 gradient-text">AI Observability Deep Dive</h3>
                    <p class="mb-4 text-text-muted">AI Development • Observability • Monitoring</p>
                    <p class="mb-6">Live coding session building AI-powered monitoring solutions from scratch.</p>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a 
                            href="https://youtu.be/W8ShFoa7ALY" 
                            target="_blank" 
                            rel="noopener noreferrer" 
                            class="btn btn-outline"
                        >
                            Watch on YouTube
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Stream Topics Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-16">
                <span class="scattered-letters">
                    <span>S</span><span>t</span><span>r</span><span>e</span><span>a</span><span>m</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>T</span><span>o</span><span>p</span><span>i</span><span>c</span><span>s</span>
                </span>
            </h2>
            <div class="grid md:grid-cols-3 gap-8">
                <div class="project-card">
                    <div class="text-4xl mb-4 gradient-text">💻</div>
                    <h3 class="mb-4 gradient-text">Live Coding</h3>
                    <p class="mb-4">Building observability tools, AI integrations, and monitoring solutions in real-time with community input.</p>
                </div>

                <div class="project-card">
                    <div class="text-4xl mb-4 gradient-text-secondary">🎯</div>
                    <h3 class="mb-4 gradient-text-secondary">Problem Solving</h3>
                    <p class="mb-4">Collaborative troubleshooting sessions tackling real-world observability and performance challenges.</p>
                </div>

                <div class="project-card">
                    <div class="text-4xl mb-4 gradient-text">📚</div>
                    <h3 class="mb-4 gradient-text">Learning Sessions</h3>
                    <p class="mb-4">Educational content covering new technologies, best practices, and emerging trends in observability.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="section">
        <div class="max-w-4xl mx-auto text-center">
            <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
                <a href="/projects" class="btn btn-lg btn-outline">Back to Datadog</a>
            </div>

            <!-- Social Links -->
            <div class="border-t border-gray-800 pt-12">
                <h3 class="mb-6 gradient-text-secondary">Follow Our Streams</h3>
                <div class="flex flex-wrap justify-center gap-6">
                    <a href="https://youtube.com/@jhand" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-primary transition-colors">
                        📺 YouTube
                    </a>
                    <a
                        href="https://github.com/jasonhand"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-secondary transition-colors"
                    >
                        💻 GitHub
                    </a>
                    <a
                        href="https://www.tiktok.com/@jason.hand"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-accent transition-colors"
                    >
                        🎵 TikTok
                    </a>
                    <a
                        href="https://www.linkedin.com/in/jasonhand24"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-primary transition-colors"
                    >
                        💼 LinkedIn
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>
