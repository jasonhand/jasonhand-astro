---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Demos - Jason Hand">
    <!-- Hero Section -->
    <section class="section-hero">
        <div class="max-w-4xl mx-auto text-center">
            <h1 class="mb-8">
                <span class="scattered-letters">
                    <span>D</span><span>e</span><span>m</span><span>o</span><span>s</span>
                </span>
            </h1>
            <p class="text-xl md:text-2xl mb-12 max-w-2xl mx-auto">
                Interactive demonstrations and experimental applications showcasing modern web technologies and innovative solutions.
            </p>
        </div>
    </section>

    <!-- Overview Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <div class="grid md:grid-cols-2 gap-16 items-center mb-20">
                <div>
                    <h2 class="mb-8 gradient-text">Experimental Playground</h2>
                    <p class="mb-6">
                        These demo applications serve as a testing ground for new technologies, design patterns, and development approaches. Each app explores
                        different aspects of modern web development.
                    </p>
                    <p class="mb-6">
                        From AI integrations to cutting-edge UI frameworks, these demos showcase what's possible when creativity meets technology.
                    </p>
                    <p>Feel free to explore, interact, and get inspired by these experimental projects that push the boundaries of web development.</p>
                </div>
                <div class="relative">
                    <div class="w-full h-96 bg-gradient-to-br from-secondary/20 to-accent/20 rounded-2xl flex items-center justify-center">
                        <span class="text-6xl gradient-text-secondary">🚀</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- All Demos Grid Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-16">
                <span class="scattered-letters">
                    <span>A</span><span>l</span><span>l</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>D</span><span>e</span><span>m</span><span>o</span><span>s</span>
                </span>
            </h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Festy Packer -->
                <div class="project-card">
                    <div class="mb-4">
                        <div class="w-full h-48 bg-gradient-to-br from-primary/30 to-secondary/30 rounded-lg flex items-center justify-center">
                            <span class="text-4xl">🎒</span>
                        </div>
                    </div>
                    <h3 class="mb-4 gradient-text">Festy Packer</h3>
                    <p class="mb-4 text-text-muted">Festival Planning • Packing Lists • Organization</p>
                    <p class="mb-6">A comprehensive festival packing and planning tool to help you prepare for your next adventure.</p>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a href="https://festypacker.com" target="_blank" rel="noopener noreferrer" class="btn">Try Demo</a>
                        <a href="https://festypacker.com" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Visit Site</a>
                    </div>
                </div>

                <!-- See Ya There -->
                <div class="project-card">
                    <div class="mb-4">
                        <div class="w-full h-48 bg-gradient-to-br from-secondary/30 to-accent/30 rounded-lg flex items-center justify-center">
                            <span class="text-4xl">👋</span>
                        </div>
                    </div>
                    <h3 class="mb-4 gradient-text-secondary">See Ya There</h3>
                    <p class="mb-4 text-text-muted">Event Discovery • Location-based • Social</p>
                    <p class="mb-6">A location-based event discovery platform that helps you find and connect with local events and activities in your area.</p>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a href="https://seeyathere.co/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Try Demo</a>
                        <a href="https://seeyathere.co/" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Visit Site</a>
                    </div>
                </div>

                <!-- Split Sumthin -->
                <div class="project-card">
                    <div class="mb-4">
                        <div class="w-full h-48 bg-gradient-to-br from-accent/30 to-primary/30 rounded-lg flex items-center justify-center">
                            <span class="text-4xl">💰</span>
                        </div>
                    </div>
                    <h3 class="mb-4 gradient-text">Split Sumthin</h3>
                    <p class="mb-4 text-text-muted">Expense Splitting • Bill Management • Finance</p>
                    <p class="mb-6">An intuitive expense splitting and bill management application for groups and roommates.</p>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a href="https://splitsumthin.com/" target="_blank" rel="noopener noreferrer" class="btn">Try Demo</a>
                        <a href="https://splitsumthin.com/" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Visit Site</a>
                    </div>
                </div>

                <!-- Camp Tribute -->
                <div class="project-card">
                    <div class="mb-4">
                        <div class="w-full h-48 bg-gradient-to-br from-primary/30 to-accent/30 rounded-lg flex items-center justify-center">
                            <span class="text-4xl">🏕️</span>
                        </div>
                    </div>
                    <h3 class="mb-4 gradient-text-secondary">Camp Tribute</h3>
                    <p class="mb-4 text-text-muted">Camping • Outdoor Adventure • Planning</p>
                    <p class="mb-6">A comprehensive camping and outdoor adventure planner for nature enthusiasts and outdoor explorers.</p>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a href="https://camptribute.com/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Try Demo</a>
                        <a href="https://camptribute.com/" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Visit Site</a>
                    </div>
                </div>

                <!-- Spr1nklr -->
                <div class="project-card">
                    <div class="mb-4">
                        <div class="w-full h-48 bg-gradient-to-br from-secondary/30 to-primary/30 rounded-lg flex items-center justify-center">
                            <span class="text-4xl">💧</span>
                        </div>
                    </div>
                    <h3 class="mb-4 gradient-text">Spr1nklr</h3>
                    <p class="mb-4 text-text-muted">Watering System • Visualization • Planning</p>
                    <p class="mb-6">A watering system visualizer and planner for efficient garden and landscape irrigation management.</p>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a href="https://watering-works-visualizer.lovable.app/" target="_blank" rel="noopener noreferrer" class="btn">Try Demo</a>
                        <a href="https://watering-works-visualizer.lovable.app/" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Visit Site</a
                        >
                    </div>
                </div>

                <!-- AI Tools Lab Quiz -->
                <div class="project-card">
                    <div class="mb-4">
                        <div class="w-full h-48 bg-gradient-to-br from-accent/30 to-secondary/30 rounded-lg flex items-center justify-center">
                            <span class="text-4xl">🤖</span>
                        </div>
                    </div>
                    <h3 class="mb-4 gradient-text-secondary">AI Tools Lab Quiz</h3>
                    <p class="mb-4 text-text-muted">AI Knowledge • Interactive Quiz • Learning</p>
                    <p class="mb-6">An interactive quiz game testing knowledge of AI tools and technologies in an engaging format.</p>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a href="https://ai-tools-lab.com/quiz-challenge" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Try Demo</a>
                        <a href="https://ai-tools-lab.com/quiz-challenge" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Visit Site</a>
                    </div>
                </div>

                <!-- Toroidal Field -->
                <div class="project-card">
                    <div class="mb-4">
                        <div class="w-full h-48 bg-gradient-to-br from-secondary/30 to-accent/30 rounded-lg flex items-center justify-center">
                            <span class="text-4xl">🌀</span>
                        </div>
                    </div>
                    <h3 class="mb-4 gradient-text-secondary">Lissajous Curves</h3>
                    <p class="mb-4 text-text-muted">Mathematical Visualization • Canvas • Animation</p>
                    <p class="mb-6">Interactive visualization of Lissajous curves with real-time parameter controls and beautiful mathematical patterns.</p>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a href="https://jasonhand.github.io/Lissajous-Demo/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Try Demo</a>
                        <a href="https://github.com/jasonhand/Lissajous-Demo" target="_blank" rel="noopener noreferrer" class="btn btn-outline">View Code</a>
                    </div>
                </div>

                <!-- PSPSPS -->
                <div class="project-card">
                    <div class="mb-4">
                        <div class="w-full h-48 bg-gradient-to-br from-accent/30 to-primary/30 rounded-lg flex items-center justify-center">
                            <span class="text-4xl">🐱</span>
                        </div>
                    </div>
                    <h3 class="mb-4 gradient-text">PSPSPS</h3>
                    <p class="mb-4 text-text-muted">Fun • Interactive • Cat-themed</p>
                    <p class="mb-6">A playful interactive application that brings joy through cat-themed interactions and delightful animations.</p>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a href="https://pspsps.app/" target="_blank" rel="noopener noreferrer" class="btn">Try Demo</a>
                        <a href="https://github.com/jasonhand/pspsps" target="_blank" rel="noopener noreferrer" class="btn btn-outline">View Code</a>
                    </div>
                </div>

                <!-- JS Ignite Karaoke -->
                <div class="project-card">
                    <div class="mb-4">
                        <div class="w-full h-48 bg-gradient-to-br from-primary/30 to-accent/30 rounded-lg flex items-center justify-center">
                            <span class="text-4xl">🎤</span>
                        </div>
                    </div>
                    <h3 class="mb-4 gradient-text-secondary">JS Ignite Karaoke</h3>
                    <p class="mb-4 text-text-muted">JavaScript • Audio • Interactive</p>
                    <p class="mb-6">A JavaScript-powered karaoke application with real-time lyrics display and interactive audio controls.</p>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a href="https://jasonhand.github.io/js-ignite-karaoke/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Try Demo</a
                        >
                        <a href="https://github.com/jasonhand/js-ignite-karaoke" target="_blank" rel="noopener noreferrer" class="btn btn-outline">View Code</a>
                    </div>
                </div>

                <!-- Vinyl Viewer -->
                <div class="project-card">
                    <div class="mb-4">
                        <div class="w-full h-48 bg-gradient-to-br from-secondary/30 to-primary/30 rounded-lg flex items-center justify-center">
                            <span class="text-4xl">💿</span>
                        </div>
                    </div>
                    <h3 class="mb-4 gradient-text">Vinyl Viewer</h3>
                    <p class="mb-4 text-text-muted">Music • Collection • Visualization</p>
                    <p class="mb-6">A beautiful interface for browsing and displaying vinyl record collections with detailed album information and artwork.</p>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a href="https://jasonhand.github.io/vinyl-viewer/" target="_blank" rel="noopener noreferrer" class="btn">Try Demo</a>
                        <a href="https://github.com/jasonhand/vinyl-viewer" target="_blank" rel="noopener noreferrer" class="btn btn-outline">View Code</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Experimental Features Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-16">
                <span class="scattered-letters">
                    <span>E</span><span>x</span><span>p</span><span>e</span><span>r</span><span>i</span><span>m</span><span>e</span><span>n</span><span>t</span
                    ><span>a</span><span>l</span>
                </span>
            </h2>
            <div class="grid md:grid-cols-3 gap-8">
                <div class="project-card">
                    <div class="text-4xl mb-4 gradient-text">🧪</div>
                    <h3 class="mb-4 gradient-text">WebAssembly Performance</h3>
                    <p class="mb-4">Exploring the performance benefits of WebAssembly for computationally intensive web applications.</p>
                    <a href="#" class="btn btn-outline">Explore</a>
                </div>

                <div class="project-card">
                    <div class="text-4xl mb-4 gradient-text-secondary">🌐</div>
                    <h3 class="mb-4 gradient-text-secondary">Progressive Web Apps</h3>
                    <p class="mb-4">Advanced PWA features including offline functionality, push notifications, and native-like experiences.</p>
                    <a href="#" class="btn btn-outline">Explore</a>
                </div>

                <div class="project-card">
                    <div class="text-4xl mb-4 gradient-text">🎯</div>
                    <h3 class="mb-4 gradient-text">Edge Computing</h3>
                    <p class="mb-4">Leveraging edge functions and distributed computing for ultra-fast, globally distributed applications.</p>
                    <a href="#" class="btn btn-outline">Explore</a>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="section">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="mb-8 gradient-text">Explore & Experiment</h2>
            <p class="text-xl mb-12">These demos are constantly evolving, showcasing the latest technologies and innovative approaches to web development.</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
                <a href="/projects" class="btn btn-lg">View Datadog Work</a>
                <a href="/devrel" class="btn btn-lg btn-outline">Developer Relations</a>
            </div>

            <!-- Social Links -->
            <div class="border-t border-gray-800 pt-12">
                <h3 class="mb-6 gradient-text-secondary">Follow My Experiments</h3>
                <div class="flex flex-wrap justify-center gap-6">
                    <a href="https://youtube.com/@jhand" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-primary transition-colors">
                        📺 YouTube
                    </a>
                    <a
                        href="https://github.com/jasonhand"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-secondary transition-colors"
                    >
                        💻 GitHub
                    </a>
                    <a
                        href="https://www.tiktok.com/@jason.hand"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-accent transition-colors"
                    >
                        🎵 TikTok
                    </a>
                    <a
                        href="https://www.linkedin.com/in/jasonhand24"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-primary transition-colors"
                    >
                        💼 LinkedIn
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>
