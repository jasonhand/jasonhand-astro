---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="AI Energy Impact Demo">
    <section class="section py-16">
        <div class="max-w-3xl mx-auto">
            <img
                src="/images/screenshots/ai_energy_consumption.png"
                alt="AI Energy Impact Screenshot"
                class="rounded-xl shadow-lg mb-8 w-full h-auto"
                loading="lazy"
            />
            <h1 class="gradient-text text-4xl font-bold mb-4">AI Energy Impact</h1>
            <p class="text-lg mb-6 text-text-muted">
                A data visualization tool that explores the environmental impact of AI systems and machine learning models, featuring energy consumption
                analysis and sustainability metrics.
            </p>
            <div class="mb-6">
                <span class="inline-block bg-primary/10 text-primary px-3 py-1 rounded-full mr-2 mb-2">AI</span>
                <span class="inline-block bg-secondary/10 text-secondary px-3 py-1 rounded-full mr-2 mb-2">Energy</span>
                <span class="inline-block bg-accent/10 text-accent px-3 py-1 rounded-full mr-2 mb-2">Sustainability</span>
                <span class="inline-block bg-gray-700 text-white px-3 py-1 rounded-full mr-2 mb-2">Environment</span>
            </div>
            <ul class="list-disc pl-6 mb-8 text-base">
                <li>Energy consumption analysis</li>
                <li>Sustainability metrics</li>
                <li>Interactive charts</li>
                <li>Comparative data</li>
                <li>Environmental impact assessment</li>
            </ul>
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
                <a href="https://jasonhand.github.io/ai-engery-impact/" target="_blank" rel="noopener noreferrer" class="btn">Try Demo</a>
                <a href="https://github.com/jasonhand/ai-engery-impact" target="_blank" rel="noopener noreferrer" class="btn btn-outline">View Code</a>
            </div>
            <div class="text-sm text-text-muted">Tech Stack: JavaScript, D3.js, Data Analysis, HTML5</div>
            <div class="text-sm text-text-muted mt-2">Status: Live &bull; Difficulty: Intermediate &bull; Released: October 2024</div>
        </div>
    </section>
</Layout>

