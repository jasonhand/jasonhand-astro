---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Ambient Weather Dashboard Demo">
    <section class="section py-16">
        <div class="max-w-3xl mx-auto">
            <img
                src="/images/screenshots/ambient_weather_dashboard.png"
                alt="Ambient Weather Dashboard Screenshot"
                class="rounded-xl shadow-lg mb-8 w-full h-auto"
                loading="lazy"
            />
            <h1 class="gradient-text text-4xl font-bold mb-4">Ambient Weather Dashboard</h1>
            <p class="text-lg mb-6 text-text-muted">
                A dashboard for visualizing and monitoring real-time weather data from Ambient Weather stations. Features device management, data visualization,
                and API integration.
            </p>
            <div class="mb-6">
                <span class="inline-block bg-secondary/10 text-secondary px-3 py-1 rounded-full mr-2 mb-2">Weather</span>
                <span class="inline-block bg-primary/10 text-primary px-3 py-1 rounded-full mr-2 mb-2">Dashboard</span>
                <span class="inline-block bg-accent/10 text-accent px-3 py-1 rounded-full mr-2 mb-2">Visualization</span>
                <span class="inline-block bg-gray-700 text-white px-3 py-1 rounded-full mr-2 mb-2">API</span>
            </div>
            <ul class="list-disc pl-6 mb-8 text-base">
                <li>Device management</li>
                <li>Real-time weather data</li>
                <li>Data visualization</li>
                <li>API integration</li>
            </ul>
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
                <a href="https://ambient-weather.lovable.app/" target="_blank" rel="noopener noreferrer" class="btn">Try Demo</a>
                <a href="https://github.com/jasonhand/ambient-weather" target="_blank" rel="noopener noreferrer" class="btn btn-outline">View Code</a>
            </div>
            <div class="text-sm text-text-muted">Tech Stack: JavaScript, HTML5, CSS3, Ambient Weather API</div>
            <div class="text-sm text-text-muted mt-2">Status: Live &bull; Difficulty: Intermediate &bull; Released: July 2024</div>
        </div>
    </section>
</Layout>
