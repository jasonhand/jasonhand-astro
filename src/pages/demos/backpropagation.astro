---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Backpropagation Visualizer Demo">
    <section class="section py-16">
        <div class="max-w-3xl mx-auto">
            <img
                src="/images/screenshots/backpropagation.png"
                alt="Backpropagation Visualizer Screenshot"
                class="rounded-xl shadow-lg mb-8 w-full h-auto"
                loading="lazy"
            />
            <h1 class="gradient-text text-4xl font-bold mb-4">Backpropagation Visualizer</h1>
            <p class="text-lg mb-6 text-text-muted">
                A comprehensive visualization tool for understanding backpropagation in neural networks, featuring interactive network diagrams and gradient
                flow visualization.
            </p>
            <div class="mb-6">
                <span class="inline-block bg-primary/10 text-primary px-3 py-1 rounded-full mr-2 mb-2">Neural Networks</span>
                <span class="inline-block bg-secondary/10 text-secondary px-3 py-1 rounded-full mr-2 mb-2">Backpropagation</span>
                <span class="inline-block bg-accent/10 text-accent px-3 py-1 rounded-full mr-2 mb-2">AI</span>
                <span class="inline-block bg-gray-700 text-white px-3 py-1 rounded-full mr-2 mb-2">Education</span>
            </div>
            <ul class="list-disc pl-6 mb-8 text-base">
                <li>Network architecture visualization</li>
                <li>Gradient flow animation</li>
                <li>Interactive training</li>
                <li>Parameter updates</li>
                <li>Educational content</li>
            </ul>
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
                <a href="https://jasonhand.github.io/backpropagation/" target="_blank" rel="noopener noreferrer" class="btn">Try Demo</a>
                <a href="https://github.com/jasonhand/backpropagation" target="_blank" rel="noopener noreferrer" class="btn btn-outline">View Code</a>
            </div>
            <div class="text-sm text-text-muted">Tech Stack: JavaScript, Canvas API, Neural Networks, Mathematics</div>
            <div class="text-sm text-text-muted mt-2">Status: Live &bull; Difficulty: Advanced &bull; Released: October 2024</div>
        </div>
    </section>
</Layout>

