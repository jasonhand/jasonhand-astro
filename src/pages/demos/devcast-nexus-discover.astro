---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="DevCast Nexus Discover Demo">
    <section class="section py-16">
        <div class="max-w-3xl mx-auto">
            <img
                src="/images/screenshots/devcast_discovery.png"
                alt="DevCast Nexus Discover Screenshot"
                class="rounded-xl shadow-lg mb-8 w-full h-auto"
                loading="lazy"
            />
            <h1 class="gradient-text text-4xl font-bold mb-4">DevCast Nexus Discover</h1>
            <p class="text-lg mb-6 text-text-muted">
                A discovery platform for developer podcasts and content, featuring curated recommendations, search functionality, and community-driven content
                discovery.
            </p>
            <div class="mb-6">
                <span class="inline-block bg-primary/10 text-primary px-3 py-1 rounded-full mr-2 mb-2">Podcasts</span>
                <span class="inline-block bg-secondary/10 text-secondary px-3 py-1 rounded-full mr-2 mb-2">Developer Content</span>
                <span class="inline-block bg-accent/10 text-accent px-3 py-1 rounded-full mr-2 mb-2">Discovery</span>
                <span class="inline-block bg-gray-700 text-white px-3 py-1 rounded-full mr-2 mb-2">Community</span>
            </div>
            <ul class="list-disc pl-6 mb-8 text-base">
                <li>Podcast discovery</li>
                <li>Curated recommendations</li>
                <li>Search functionality</li>
                <li>Community features</li>
                <li>Content categorization</li>
            </ul>
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
                <a href="https://devcast-nexus-discover.lovable.app/" target="_blank" rel="noopener noreferrer" class="btn">Try Demo</a>
                <a href="https://github.com/jasonhand/devcast-nexus-discover" target="_blank" rel="noopener noreferrer" class="btn btn-outline">View Code</a>
            </div>
            <div class="text-sm text-text-muted">Tech Stack: React, TypeScript, Podcast APIs, Netlify</div>
            <div class="text-sm text-text-muted mt-2">Status: Live &bull; Difficulty: Intermediate &bull; Released: November 2024</div>
        </div>
    </section>
</Layout>

