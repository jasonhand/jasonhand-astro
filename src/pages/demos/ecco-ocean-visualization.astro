---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="ECCO Ocean Visualization Demo">
    <section class="section py-16">
        <div class="max-w-3xl mx-auto">
            <img src="/images/screenshots/ECCO.png" alt="ECCO Ocean Visualization Screenshot" class="rounded-xl shadow-lg mb-8 w-full h-auto" loading="lazy" />
            <h1 class="gradient-text text-4xl font-bold mb-4">ECCO Ocean Visualization</h1>
            <p class="text-lg mb-6 text-text-muted">
                An interactive web application for visualizing ocean data, focusing on circulation and climate. Features an interactive 3D globe, multiple data
                layers (temperature, currents, salinity, sea level), region and time controls, and real-time data statistics.
            </p>
            <div class="mb-6">
                <span class="inline-block bg-primary/10 text-primary px-3 py-1 rounded-full mr-2 mb-2">Oceanography</span>
                <span class="inline-block bg-secondary/10 text-secondary px-3 py-1 rounded-full mr-2 mb-2">Data Visualization</span>
                <span class="inline-block bg-accent/10 text-accent px-3 py-1 rounded-full mr-2 mb-2">3D Globe</span>
                <span class="inline-block bg-gray-700 text-white px-3 py-1 rounded-full mr-2 mb-2">Climate</span>
            </div>
            <ul class="list-disc pl-6 mb-8 text-base">
                <li>3D interactive globe</li>
                <li>Multiple data layers (temperature, currents, salinity, sea level)</li>
                <li>Layer opacity control</li>
                <li>Region selection</li>
                <li>Time control</li>
                <li>Current value display</li>
                <li>Data quality metrics</li>
                <li>Statistical summaries</li>
                <li>Live data streaming</li>
            </ul>
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
                <a href="https://ecco-ocean-explorer-globe.lovable.app/" target="_blank" rel="noopener noreferrer" class="btn">Try Demo</a>
            </div>
            <div class="text-sm text-text-muted">Tech Stack: React, Three.js, WebGL, Data Visualization, Scientific APIs</div>
            <div class="text-sm text-text-muted mt-2">Status: Live &bull; Difficulty: Advanced &bull; Released: November 2025</div>
        </div>
    </section>
</Layout>
