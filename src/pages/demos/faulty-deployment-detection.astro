---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Faulty Deployment Detection Demo">
    <section class="section py-16">
        <div class="max-w-3xl mx-auto">
            <img
                src="/images/screenshots/faulty_deployment_detection.png"
                alt="Faulty Deployment Detection Screenshot"
                class="rounded-xl shadow-lg mb-8 w-full h-auto"
                loading="lazy"
            />
            <h1 class="gradient-text text-4xl font-bold mb-4">Faulty Deployment Detection</h1>
            <p class="text-lg mb-6 text-text-muted">
                A machine learning tool for detecting and analyzing faulty software deployments using pattern recognition and anomaly detection algorithms.
            </p>
            <div class="mb-6">
                <span class="inline-block bg-primary/10 text-primary px-3 py-1 rounded-full mr-2 mb-2">Machine Learning</span>
                <span class="inline-block bg-secondary/10 text-secondary px-3 py-1 rounded-full mr-2 mb-2">DevOps</span>
                <span class="inline-block bg-accent/10 text-accent px-3 py-1 rounded-full mr-2 mb-2">Deployment</span>
                <span class="inline-block bg-gray-700 text-white px-3 py-1 rounded-full mr-2 mb-2">Monitoring</span>
            </div>
            <ul class="list-disc pl-6 mb-8 text-base">
                <li>Anomaly detection</li>
                <li>Pattern recognition</li>
                <li>Deployment analysis</li>
                <li>Alert system</li>
                <li>Performance monitoring</li>
            </ul>
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
                <a href="https://jasonhand.github.io/faulty-deployment-detection/" target="_blank" rel="noopener noreferrer" class="btn">Try Demo</a>
                <a href="https://github.com/jasonhand/faulty-deployment-detection" target="_blank" rel="noopener noreferrer" class="btn btn-outline"
                    >View Code</a
                >
            </div>
            <div class="text-sm text-text-muted">Tech Stack: Python, Machine Learning, JavaScript, Data Analysis</div>
            <div class="text-sm text-text-muted mt-2">Status: Live &bull; Difficulty: Advanced &bull; Released: November 2024</div>
        </div>
    </section>
</Layout>

