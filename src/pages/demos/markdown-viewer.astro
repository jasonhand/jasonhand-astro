---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Markdown Viewer Demo">
    <section class="section py-16">
        <div class="max-w-3xl mx-auto">
            <img
                src="/images/screenshots/markdown_viewer.png"
                alt="Markdown Viewer Screenshot"
                class="rounded-xl shadow-lg mb-8 w-full h-auto"
                loading="lazy"
            />
            <h1 class="gradient-text text-4xl font-bold mb-4">Markdown Viewer</h1>
            <p class="text-lg mb-6 text-text-muted">
                A simple, lightweight markdown previewer inspired by YiViewer. Instantly preview markdown files as HTML with auto-update and export features.
            </p>
            <div class="mb-6">
                <span class="inline-block bg-accent/10 text-accent px-3 py-1 rounded-full mr-2 mb-2">Markdown</span>
                <span class="inline-block bg-primary/10 text-primary px-3 py-1 rounded-full mr-2 mb-2">Viewer</span>
                <span class="inline-block bg-secondary/10 text-secondary px-3 py-1 rounded-full mr-2 mb-2">Preview</span>
                <span class="inline-block bg-gray-700 text-white px-3 py-1 rounded-full mr-2 mb-2">HTML</span>
            </div>
            <ul class="list-disc pl-6 mb-8 text-base">
                <li>Auto-update preview</li>
                <li>No dependencies</li>
                <li>Export HTML</li>
                <li>Lightweight design</li>
            </ul>
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
                <a href="https://jasonhand.github.io/markdown_viewer/" target="_blank" rel="noopener noreferrer" class="btn">Try Demo</a>
                <a href="https://github.com/jasonhand/markdown_viewer" target="_blank" rel="noopener noreferrer" class="btn btn-outline">View Code</a>
            </div>
            <div class="text-sm text-text-muted">Tech Stack: Objective-C, HTML5, CSS3</div>
            <div class="text-sm text-text-muted mt-2">Status: Live &bull; Difficulty: Beginner &bull; Released: July 2024</div>
        </div>
    </section>
</Layout>
