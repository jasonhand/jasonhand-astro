---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Music Theory Lessons Demo">
    <section class="section py-16">
        <div class="max-w-3xl mx-auto">
            <img
                src="/images/screenshots/music_theory_lessons.png"
                alt="Music Theory Lessons Screenshot"
                class="rounded-xl shadow-lg mb-8 w-full h-auto"
                loading="lazy"
            />
            <h1 class="gradient-text text-4xl font-bold mb-4">Music Theory Lessons</h1>
            <p class="text-lg mb-6 text-text-muted">
                A comprehensive music theory learning platform with interactive lessons, exercises, and visual aids for understanding musical concepts and
                notation.
            </p>
            <div class="mb-6">
                <span class="inline-block bg-primary/10 text-primary px-3 py-1 rounded-full mr-2 mb-2">Music Theory</span>
                <span class="inline-block bg-secondary/10 text-secondary px-3 py-1 rounded-full mr-2 mb-2">Education</span>
                <span class="inline-block bg-accent/10 text-accent px-3 py-1 rounded-full mr-2 mb-2">Interactive</span>
                <span class="inline-block bg-gray-700 text-white px-3 py-1 rounded-full mr-2 mb-2">Lessons</span>
            </div>
            <ul class="list-disc pl-6 mb-8 text-base">
                <li>Interactive lessons</li>
                <li>Audio examples</li>
                <li>Visual notation</li>
                <li>Progress tracking</li>
                <li>Practice exercises</li>
            </ul>
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
                <a href="https://jasonhand.github.io/music-theory-lessons/" target="_blank" rel="noopener noreferrer" class="btn">Try Demo</a>
                <a href="https://github.com/jasonhand/music-theory-lessons" target="_blank" rel="noopener noreferrer" class="btn btn-outline">View Code</a>
            </div>
            <div class="text-sm text-text-muted">Tech Stack: HTML5, CSS3, JavaScript, Web Audio API</div>
            <div class="text-sm text-text-muted mt-2">Status: Live &bull; Difficulty: Beginner &bull; Released: September 2024</div>
        </div>
    </section>
</Layout>

