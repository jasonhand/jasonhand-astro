---
import Layout from '../../layouts/Layout.astro';
import { getDemoById } from '../../data/demos';

const demo = getDemoById('pspsps');
if (!demo) {
    return Astro.redirect('/demos');
}
---

<Layout title={`${demo.title} - Demo - Jason Hand`}>
    <section class="section py-16">
        <div class="max-w-3xl mx-auto">
            <img src="/images/screenshots/pspsps.png" alt="PSPSPS Screenshot" class="rounded-xl shadow-lg mb-8 w-full h-auto" loading="lazy" />
            <h1 class="gradient-text text-4xl font-bold mb-4">{demo.title}</h1>
            <p class="text-lg mb-6 text-text-muted">{demo.description}</p>
            <div class="mb-6">
                <span class="inline-block bg-accent/10 text-accent px-3 py-1 rounded-full mr-2 mb-2">Fun</span>
                <span class="inline-block bg-primary/10 text-primary px-3 py-1 rounded-full mr-2 mb-2">Interactive</span>
                <span class="inline-block bg-secondary/10 text-secondary px-3 py-1 rounded-full mr-2 mb-2">Cat-themed</span>
                <span class="inline-block bg-gray-700 text-white px-3 py-1 rounded-full mr-2 mb-2">Animation</span>
            </div>
            <ul class="list-disc pl-6 mb-8 text-base">
                {demo.features?.map((feature) => <li>{feature}</li>)}
            </ul>
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
                <a href={demo.url} target="_blank" rel="noopener noreferrer" class="btn">Try Demo</a>
                {
                    demo.githubUrl && (
                        <a href={demo.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
                            View Code
                        </a>
                    )
                }
            </div>
            <div class="text-sm text-text-muted">Tech Stack: {demo.techStack?.join(', ')}</div>
            <div class="text-sm text-text-muted mt-2">
                Status: {demo.status.charAt(0).toUpperCase() + demo.status.slice(1)} &bull; Difficulty: {
                    demo.difficulty.charAt(0).toUpperCase() + demo.difficulty.slice(1)
                } &bull; Released: {new Date(demo.createdAt).toLocaleDateString()}
            </div>
        </div>
    </section>
</Layout>
