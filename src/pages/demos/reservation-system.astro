---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Pine Ridge Resort Reservation System Demo">
    <section class="section py-16">
        <div class="max-w-3xl mx-auto">
            <img
                src="/images/screenshots/reservation_system.png"
                alt="Pine Ridge Resort Reservation System Screenshot"
                class="rounded-xl shadow-lg mb-8 w-full h-auto"
                loading="lazy"
            />
            <h1 class="gradient-text text-4xl font-bold mb-4">Pine Ridge Resort Reservation System</h1>
            <p class="text-lg mb-6 text-text-muted">
                A comprehensive reservation and booking system for Pine Ridge Resort, featuring room availability, booking management, and guest services
                integration.
            </p>
            <div class="mb-6">
                <span class="inline-block bg-primary/10 text-primary px-3 py-1 rounded-full mr-2 mb-2">Reservations</span>
                <span class="inline-block bg-secondary/10 text-secondary px-3 py-1 rounded-full mr-2 mb-2">Hotel</span>
                <span class="inline-block bg-accent/10 text-accent px-3 py-1 rounded-full mr-2 mb-2">Booking</span>
                <span class="inline-block bg-gray-700 text-white px-3 py-1 rounded-full mr-2 mb-2">Management</span>
            </div>
            <ul class="list-disc pl-6 mb-8 text-base">
                <li>Room availability tracking</li>
                <li>Online booking</li>
                <li>Guest management</li>
                <li>Payment processing</li>
                <li>Service integration</li>
            </ul>
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
                <a href="https://pineridgeresort.netlify.app/" target="_blank" rel="noopener noreferrer" class="btn">Try Demo</a>
                <a href="https://github.com/jasonhand/reservations_system" target="_blank" rel="noopener noreferrer" class="btn btn-outline">View Code</a>
            </div>
            <div class="text-sm text-text-muted">Tech Stack: React, TypeScript, Booking System, Netlify</div>
            <div class="text-sm text-text-muted mt-2">Status: Live &bull; Difficulty: Intermediate &bull; Released: November 2024</div>
        </div>
    </section>
</Layout>

