---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Robots.txt Generator Demo">
    <section class="section py-16">
        <div class="max-w-3xl mx-auto">
            <img
                src="/images/screenshots/robot_txt_generator.png"
                alt="Robots.txt Generator Screenshot"
                class="rounded-xl shadow-lg mb-8 w-full h-auto"
                loading="lazy"
            />
            <h1 class="gradient-text text-4xl font-bold mb-4">Robots.txt Generator</h1>
            <p class="text-lg mb-6 text-text-muted">
                A web-based tool for generating and validating robots.txt files with interactive interface and real-time syntax checking for web crawler
                configuration.
            </p>
            <div class="mb-6">
                <span class="inline-block bg-primary/10 text-primary px-3 py-1 rounded-full mr-2 mb-2">SEO</span>
                <span class="inline-block bg-secondary/10 text-secondary px-3 py-1 rounded-full mr-2 mb-2">Web Crawlers</span>
                <span class="inline-block bg-accent/10 text-accent px-3 py-1 rounded-full mr-2 mb-2">Robots.txt</span>
                <span class="inline-block bg-gray-700 text-white px-3 py-1 rounded-full mr-2 mb-2">Generator</span>
            </div>
            <ul class="list-disc pl-6 mb-8 text-base">
                <li>Interactive generator</li>
                <li>Syntax validation</li>
                <li>Real-time preview</li>
                <li>Common patterns</li>
                <li>Download functionality</li>
            </ul>
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
                <a href="https://jasonhand.github.io/robots-txt-generator/" target="_blank" rel="noopener noreferrer" class="btn">Try Demo</a>
                <a href="https://github.com/jasonhand/robots-txt-generator" target="_blank" rel="noopener noreferrer" class="btn btn-outline">View Code</a>
            </div>
            <div class="text-sm text-text-muted">Tech Stack: JavaScript, HTML5, CSS3, Web Standards</div>
            <div class="text-sm text-text-muted mt-2">Status: Live &bull; Difficulty: Beginner &bull; Released: November 2025</div>
        </div>
    </section>
</Layout>
