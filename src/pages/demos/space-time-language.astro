---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Space Time Language Demo">
    <section class="section py-16">
        <div class="max-w-3xl mx-auto">
            <img
                src="/images/screenshots/space-time-language.png"
                alt="Space Time Language Screenshot"
                class="rounded-xl shadow-lg mb-8 w-full h-auto"
                loading="lazy"
            />
            <h1 class="gradient-text text-4xl font-bold mb-4">Space Time Language</h1>
            <p class="text-lg mb-6 text-text-muted">
                An interactive exploration of language patterns across time and space, visualizing how communication evolves and adapts in different contexts.
            </p>
            <div class="mb-6">
                <span class="inline-block bg-primary/10 text-primary px-3 py-1 rounded-full mr-2 mb-2">Language</span>
                <span class="inline-block bg-secondary/10 text-secondary px-3 py-1 rounded-full mr-2 mb-2">Visualization</span>
                <span class="inline-block bg-accent/10 text-accent px-3 py-1 rounded-full mr-2 mb-2">Patterns</span>
                <span class="inline-block bg-gray-700 text-white px-3 py-1 rounded-full mr-2 mb-2">Interactive</span>
            </div>
            <ul class="list-disc pl-6 mb-8 text-base">
                <li>Language pattern visualization</li>
                <li>Interactive data exploration</li>
                <li>Time-based analysis</li>
                <li>Spatial representation</li>
            </ul>
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
                <a href="https://jasonhand.github.io/space-time-language/" target="_blank" rel="noopener noreferrer" class="btn">Try Demo</a>
                <a href="https://github.com/jasonhand/space-time-language" target="_blank" rel="noopener noreferrer" class="btn btn-outline">View Code</a>
            </div>
            <div class="text-sm text-text-muted">Tech Stack: JavaScript, D3.js, HTML5, CSS3</div>
            <div class="text-sm text-text-muted mt-2">Status: Live &bull; Difficulty: Intermediate &bull; Released: August 2024</div>
        </div>
    </section>
</Layout>

