---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Stardust Demo">
    <section class="section py-16">
        <div class="max-w-3xl mx-auto">
            <img src="/images/screenshots/stardust.png" alt="Stardust Screenshot" class="rounded-xl shadow-lg mb-8 w-full h-auto" loading="lazy" />
            <h1 class="gradient-text text-4xl font-bold mb-4">Stardust</h1>
            <p class="text-lg mb-6 text-text-muted">
                A mesmerizing particle system visualization that creates beautiful cosmic effects with interactive controls and dynamic particle behavior.
            </p>
            <div class="mb-6">
                <span class="inline-block bg-primary/10 text-primary px-3 py-1 rounded-full mr-2 mb-2">Particles</span>
                <span class="inline-block bg-secondary/10 text-secondary px-3 py-1 rounded-full mr-2 mb-2">Visualization</span>
                <span class="inline-block bg-accent/10 text-accent px-3 py-1 rounded-full mr-2 mb-2">Cosmic</span>
                <span class="inline-block bg-gray-700 text-white px-3 py-1 rounded-full mr-2 mb-2">Animation</span>
            </div>
            <ul class="list-disc pl-6 mb-8 text-base">
                <li>Dynamic particle systems</li>
                <li>Interactive controls</li>
                <li>Cosmic effects</li>
                <li>Performance optimization</li>
                <li>Real-time animation</li>
            </ul>
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
                <a href="https://jasonhand.github.io/stardust/" target="_blank" rel="noopener noreferrer" class="btn">Try Demo</a>
                <a href="https://github.com/jasonhand/stardust" target="_blank" rel="noopener noreferrer" class="btn btn-outline">View Code</a>
            </div>
            <div class="text-sm text-text-muted">Tech Stack: JavaScript, Canvas API, Particle Systems, WebGL</div>
            <div class="text-sm text-text-muted mt-2">Status: Live &bull; Difficulty: Intermediate &bull; Released: October 2024</div>
        </div>
    </section>
</Layout>

