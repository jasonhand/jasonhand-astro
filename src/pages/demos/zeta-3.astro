---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Zeta-3 Demo">
    <section class="section py-16">
        <div class="max-w-3xl mx-auto">
            <img src="/images/screenshots/zeta-3.png" alt="Zeta-3 Screenshot" class="rounded-xl shadow-lg mb-8 w-full h-auto" loading="lazy" />
            <h1 class="gradient-text-secondary text-4xl font-bold mb-4">Zeta-3</h1>
            <p class="text-lg mb-6 text-text-muted">
                A mathematical exploration and visualization of the zeta function and its properties, featuring interactive controls and beautiful mathematical
                patterns.
            </p>
            <div class="mb-6">
                <span class="inline-block bg-primary/10 text-primary px-3 py-1 rounded-full mr-2 mb-2">Mathematics</span>
                <span class="inline-block bg-secondary/10 text-secondary px-3 py-1 rounded-full mr-2 mb-2">Zeta Function</span>
                <span class="inline-block bg-accent/10 text-accent px-3 py-1 rounded-full mr-2 mb-2">Visualization</span>
                <span class="inline-block bg-gray-700 text-white px-3 py-1 rounded-full mr-2 mb-2">Complex Analysis</span>
            </div>
            <ul class="list-disc pl-6 mb-8 text-base">
                <li>Zeta function visualization</li>
                <li>Interactive parameter controls</li>
                <li>Mathematical accuracy</li>
                <li>Complex number representation</li>
            </ul>
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
                <a href="https://jasonhand.github.io/zeta-3/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Try Demo</a>
                <a href="https://github.com/jasonhand/zeta-3" target="_blank" rel="noopener noreferrer" class="btn btn-outline">View Code</a>
            </div>
            <div class="text-sm text-text-muted">Tech Stack: JavaScript, Canvas API, Math.js, HTML5</div>
            <div class="text-sm text-text-muted mt-2">Status: Live &bull; Difficulty: Advanced &bull; Released: August 2025</div>
        </div>
    </section>
</Layout>
