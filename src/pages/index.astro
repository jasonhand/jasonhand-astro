---
import Layout from '../layouts/Layout.astro';
import SkillsFilter from '../components/SkillsFilter';
import { getFeaturedDemos, getAllDemos } from '../data/demos';
import { getDemoImagePath } from '../utils/imageMapping';
import { getLatestContent, getLatestGuestAppearance } from '../utils/latestContent';
import { getLatestAIToolsLabVideo, getLatestYouTubeShortsVideo } from '../utils/youtube';
import { hasBlogPostForDemo } from '../data/blog';

// Try to get the latest AI Tools Lab video
// Falls back to null if not available (will show placeholder)
const latestVideo = await getLatestAIToolsLabVideo();
// Fallback video ID if automatic fetch fails (you can set this manually)
const fallbackVideoId = import.meta.env.AI_TOOLS_LAB_FALLBACK_VIDEO_ID || null;
const videoId = latestVideo?.videoId || fallbackVideoId;

// Try to get the latest YouTube Shorts video
const latestShortsVideo = await getLatestYouTubeShortsVideo();
const fallbackShortsVideoId = import.meta.env.YOUTUBE_SHORTS_FALLBACK_VIDEO_ID || null;
const shortsVideoId = latestShortsVideo?.videoId || fallbackShortsVideoId;

const featuredDemos = getFeaturedDemos();
const allDemos = getAllDemos();
const latestContent = getLatestContent(6);
const latestGuestAppearance = getLatestGuestAppearance();

function formatDate(dateString: string): string {
    return new Date(dateString).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    });
}

function getTypeLabel(type: string): string {
    const labels: Record<string, string> = {
        blog: 'Blog Post',
        podcast: 'Podcast',
        video: 'Video',
        publication: 'Publication',
        'guest-appearance': 'Guest Appearance'
    };
    return labels[type] || type;
}
---

<Layout title="Jason Hand - Developer & Creator">
    <!-- Hero Section -->
    <section class="section-hero">
        <div class="max-w-6xl mx-auto">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
                <!-- Profile Image -->
                <div class="order-1 lg:order-1 flex justify-center">
                    <div class="relative">
                        <div
                            class="w-80 h-80 md:w-96 md:h-96 lg:w-[28rem] lg:h-[28rem] rounded-full overflow-hidden border-4 border-gradient-to-r from-primary to-secondary p-1 bg-gradient-to-r from-primary to-secondary"
                        >
                            <div class="w-full h-full rounded-full overflow-hidden bg-background">
                                <img
                                    src="/images/Jhand_AI_Profile.png"
                                    alt="Jason Hand - Developer & Creator"
                                    width="448"
                                    height="448"
                                    fetchpriority="high"
                                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                                />
                            </div>
                        </div>
                        <!-- Floating elements around the image -->
                        <div class="absolute -top-4 -right-4 w-8 h-8 bg-gradient-to-r from-primary to-secondary rounded-full animate-pulse"></div>
                        <div class="absolute -bottom-6 -left-6 w-6 h-6 bg-gradient-to-r from-secondary to-accent rounded-full animate-pulse delay-300"></div>
                        <div class="absolute top-1/2 -left-8 w-4 h-4 bg-gradient-to-r from-accent to-primary rounded-full animate-pulse delay-700"></div>
                    </div>
                </div>

                <!-- Text Content -->
                <div class="order-2 lg:order-2">
                    <h1 class="mb-8 text-left lg:text-left">
                        <span class="scattered-letters">
                            <span>J</span><span>a</span><span>s</span><span>o</span><span>n</span>
                        </span>
                        <br />
                        <span class="scattered-letters">
                            <span>H</span><span>a</span><span>n</span><span>d</span>
                        </span>
                    </h1>
                    <p class="text-xl md:text-2xl mb-8 text-left lg:text-left">Human, creator, advocate.</p>
                    <p class="text-lg mb-12 text-text-muted text-left lg:text-left max-w-lg">
                        Passionate about modern web technologies, developer relations, and creating innovative solutions that make a difference in the digital
                        world.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- AI Tools Lab Featured Section -->
    <section id="ai-tools-lab" class="section bg-gradient-to-br from-primary/5 via-background to-secondary/5">
        <div class="max-w-6xl mx-auto">
            <div class="grid md:grid-cols-2 gap-12 items-center">
                <div>
                    <div class="inline-block mb-4">
                        <span class="px-4 py-2 bg-accent/20 text-accent rounded-full text-sm font-semibold">Featured Project</span>
                    </div>
                    <h2 class="mb-6">
                        <span class="scattered-letters">
                            <span>A</span><span>I</span>
                        </span>
                        <br />
                        <span class="scattered-letters">
                            <span>T</span><span>o</span><span>o</span><span>l</span><span>s</span>
                        </span>
                        <br />
                        <span class="scattered-letters">
                            <span>L</span><span>a</span><span>b</span>
                        </span>
                    </h2>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a href="/datadog/ai-tools-lab" class="btn btn-lg">Explore AI Tools Lab</a>
                    </div>
                </div>
                <div class="relative">
                    <div class="w-full max-w-sm mx-auto aspect-[9/16] bg-gradient-to-br from-primary/20 to-secondary/20 rounded-2xl overflow-hidden shadow-xl">
                        <iframe
                            class="w-full h-full"
                            src="https://www.youtube.com/embed/videoseries?list=PLjR8CqndeyMpWN93WBE4oDLk1LveBa2sJ"
                            title="AI Tools Lab Shorts Playlist"
                            aria-label="AI Tools Lab Shorts - Short-form educational videos about AI development tools and techniques"
                            style="border: none;"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- AI Tools Lab Episodes Section (Video Only) -->
    <section id="ai-tools-lab-episodes" class="section">
        <div class="max-w-6xl mx-auto">
            <div class="w-full aspect-video bg-gradient-to-br from-primary/20 to-secondary/20 rounded-2xl overflow-hidden shadow-xl">
                <iframe
                    class="w-full h-full"
                    src="https://www.youtube.com/embed/videoseries?list=PLVOmGuoGYFgr5lvPwWpsEFm-QU_FvxzJ0"
                    title="AI Tools Lab Episodes Playlist"
                    aria-label="AI Tools Lab Episodes - Full-length technical demonstrations and educational content about AI development tools"
                    style="border: none;"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"></iframe>
            </div>
        </div>
    </section>

    <!-- Community Pulse Section -->
    <section id="community-pulse-shorts" class="section bg-gradient-to-br from-secondary/5 via-background to-accent/5">
        <div class="max-w-6xl mx-auto">
            <div class="grid md:grid-cols-2 gap-12 items-center">
                <div class="order-2 md:order-1">
                    <div class="inline-block mb-4">
                        <span class="px-4 py-2 bg-secondary/20 text-secondary rounded-full text-sm font-semibold">Latest Shorts</span>
                    </div>
                    <h2 class="mb-6">
                        <span class="scattered-letters">
                            <span>C</span><span>o</span><span>m</span><span>m</span><span>u</span><span>n</span><span>i</span><span>t</span><span>y</span>
                        </span>
                        <br />
                        <span class="scattered-letters">
                            <span>P</span><span>u</span><span>l</span><span>s</span><span>e</span>
                        </span>
                        <br />
                        <span class="scattered-letters">
                            <span>S</span><span>h</span><span>o</span><span>r</span><span>t</span><span>s</span>
                        </span>
                    </h2>
                    <p class="text-xl mb-6 text-text-muted">Quick tips, insights, and behind-the-scenes content in bite-sized format.</p>
                    <p class="mb-8 text-lg">
                        Catch the latest Community Pulse covering developer relations, community building, and industry insights. New content added regularly!
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a
                            href={`https://www.youtube.com/playlist?list=PLjR8CqndeyMofFphEh7jUHUfjzkjiStwl`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn btn-lg"
                        >
                            Watch All Shorts
                        </a>
                        <a href="https://youtube.com/@jhand" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-outline"> Subscribe </a>
                    </div>
                </div>
                <div class="relative order-1 md:order-2">
                    <div class="w-full max-w-sm mx-auto aspect-[9/16] bg-gradient-to-br from-secondary/20 to-accent/20 rounded-2xl overflow-hidden shadow-xl">
                        <iframe
                            class="w-full h-full"
                            src="https://www.youtube.com/embed/videoseries?list=PLjR8CqndeyMofFphEh7jUHUfjzkjiStwl"
                            title="Community Pulse Playlist"
                            aria-label="Community Pulse Shorts - Developer relations insights and community building content in short format"
                            style="border: none;"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Latest Guest Appearance Section -->
    {
        latestGuestAppearance && (
            <section id="guest-appearance" class="section bg-gradient-to-br from-accent/5 via-background to-primary/5">
                <div class="max-w-6xl mx-auto">
                    <div class="grid md:grid-cols-2 gap-12 items-center">
                        <div class="order-2 md:order-1">
                            <div class="inline-block mb-4">
                                <span class="px-4 py-2 bg-accent/20 text-accent rounded-full text-sm font-semibold">Guest Appearance</span>
                            </div>
                            {latestGuestAppearance.show && <p class="text-lg mb-4 text-text-muted">{latestGuestAppearance.show}</p>}
                            <h2 class="mb-6">
                                <span class="scattered-letters">
                                    <>
                                        <span>L</span>
                                        <span>a</span>
                                        <span>t</span>
                                        <span>e</span>
                                        <span>s</span>
                                        <span>t</span>
                                    </>
                                </span>
                                <br />
                                <span class="scattered-letters">
                                    <>
                                        <span>I</span>
                                        <span>n</span>
                                        <span>t</span>
                                        <span>e</span>
                                        <span>r</span>
                                        <span>v</span>
                                        <span>i</span>
                                        <span>e</span>
                                        <span>w</span>
                                    </>
                                </span>
                            </h2>
                            <h3 class="text-2xl mb-6 gradient-text">{latestGuestAppearance.title}</h3>
                            {latestGuestAppearance.description && <p class="text-lg mb-6 text-text-muted">{latestGuestAppearance.description}</p>}
                            <p class="mb-8 text-sm text-text-muted">Published {formatDate(latestGuestAppearance.date)}</p>
                            <div class="flex flex-col sm:flex-row gap-4">
                                <a href={latestGuestAppearance.url} target="_blank" rel="noopener noreferrer" class="btn btn-lg">
                                    Listen Now
                                </a>
                                <a href="https://www.youtube.com/watch?v=1jxmNoWv9WU" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-outline">
                                    Watch on YouTube
                                </a>
                            </div>
                        </div>
                        <div class="relative order-1 md:order-2">
                            {latestGuestAppearance.videoId ? (
                                <div class="w-full aspect-video bg-gradient-to-br from-accent/20 to-primary/20 rounded-2xl overflow-hidden shadow-xl">
                                    <iframe
                                        class="w-full h-full"
                                        src={`https://www.youtube.com/embed/${latestGuestAppearance.videoId}`}
                                        title={latestGuestAppearance.title}
                                        aria-label={`Latest guest appearance: ${latestGuestAppearance.title} - Watch the interview or podcast episode`}
                                        style="border: none;"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
                                    />
                                </div>
                            ) : (
                                <a
                                    href={latestGuestAppearance.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="block w-full aspect-video bg-gradient-to-br from-accent/20 to-primary/20 rounded-2xl overflow-hidden shadow-xl hover:opacity-90 transition-opacity"
                                >
                                    <div class="w-full h-full flex items-center justify-center">
                                        <div class="text-center">
                                            <div class="text-6xl mb-4 gradient-text">🎙️</div>
                                            <p class="text-xl font-semibold gradient-text">{latestGuestAppearance.show || 'Guest Appearance'}</p>
                                            <p class="text-sm text-text-muted mt-2">Click to listen</p>
                                        </div>
                                    </div>
                                </a>
                            )}
                        </div>
                    </div>
                </div>
            </section>
        )
    }

    <!-- Featured Content Section -->
    <section id="featured" class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-4">
                <span class="scattered-letters">
                    <span>L</span><span>a</span><span>t</span><span>e</span><span>s</span><span>t</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>C</span><span>o</span><span>n</span><span>t</span><span>e</span><span>n</span><span>t</span>
                </span>
            </h2>
            <p class="text-center text-xl mb-12 max-w-3xl mx-auto text-text-muted">Recent blog posts, podcast episodes, videos, and publications</p>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                <div>
                    <h2 class="mb-8">
                        <span class="scattered-letters">
                            <span>A</span><span>b</span><span>o</span><span>u</span><span>t</span>
                        </span>
                    </h2>
                    <p class="mb-6">
                        I'm a passionate developer advocate who loves creating digital experiences that push boundaries and solve real problems. With expertise
                        in modern web technologies, I help bring ideas to life.
                    </p>
                    <a href="/about" class="btn btn-secondary">Learn More</a>
                </div>
                <!-- Content cards will replace the About section -->
                {
                    latestContent.map((item) => (
                        <a
                            href={item.url}
                            target={item.url.startsWith('http') ? '_blank' : undefined}
                            rel={item.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                            class="project-card group hover:scale-[1.02] transition-transform duration-300"
                        >
                            <div class="flex items-start gap-4 mb-4">
                                <div class="text-3xl flex-shrink-0">{item.icon || '📄'}</div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2 mb-2">
                                        <span
                                            class={`text-xs px-2 py-1 rounded-full ${
                                                item.type === 'blog'
                                                    ? 'bg-primary/20 text-primary'
                                                    : item.type === 'podcast'
                                                      ? 'bg-secondary/20 text-secondary'
                                                      : item.type === 'video'
                                                        ? 'bg-accent/20 text-accent'
                                                        : item.type === 'guest-appearance'
                                                          ? 'bg-accent/20 text-accent'
                                                          : 'bg-primary/20 text-primary'
                                            }`}
                                        >
                                            {getTypeLabel(item.type)}
                                        </span>
                                        <span class="text-xs text-text-muted">{formatDate(item.date)}</span>
                                    </div>
                                    <h3
                                        class={`text-lg font-bold mb-2 line-clamp-2 ${
                                            item.type === 'blog'
                                                ? 'gradient-text'
                                                : item.type === 'podcast'
                                                  ? 'gradient-text-secondary'
                                                  : item.type === 'video'
                                                    ? 'gradient-text'
                                                    : item.type === 'guest-appearance'
                                                      ? 'gradient-text'
                                                      : 'gradient-text'
                                        }`}
                                    >
                                        {item.title}
                                    </h3>
                                    {item.type === 'guest-appearance' && 'show' in item && item.show && <p class="text-xs text-text-muted mb-2">{item.show}</p>}
                                    {item.description && <p class="text-sm text-text-muted line-clamp-2">{item.description}</p>}
                                </div>
                            </div>
                            <div class="flex items-center gap-2 text-sm text-primary group-hover:gap-4 transition-all">
                                <span>Read More</span>
                                <span>→</span>
                            </div>
                        </a>
                    ))
                }
            </div>

            <div class="text-center mt-12">
                <div class="flex flex-wrap justify-center gap-4">
                    <a href="/blog" class="btn btn-outline">All Blog Posts</a>
                    <a href="/podcasts" class="btn btn-outline">All Podcasts</a>
                    <a href="/content" class="btn btn-outline">All Content</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Skills Section -->
    <section id="skills" class="section">
        <SkillsFilter client:load />
    </section>

    <!-- Connect Section -->
    <section id="connect" class="section">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="mb-8">
                <span class="scattered-letters">
                    <span>C</span><span>o</span><span>n</span><span>n</span><span>e</span><span>c</span><span>t</span>
                </span>
            </h2>
            <p class="text-xl mb-12 max-w-2xl mx-auto">
                Follow my journey and connect with me across different platforms where I share insights, tutorials, and creative work.
            </p>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                <a href="https://youtube.com/@jhand" target="_blank" rel="noopener noreferrer" class="project-card group hover:border-red-500/50">
                    <div class="text-4xl mb-4">📺</div>
                    <h3 class="mb-2 gradient-text">YouTube</h3>
                    <p class="text-sm">Tech tutorials and insights</p>
                </a>

                <a href="https://github.com/jasonhand" target="_blank" rel="noopener noreferrer" class="project-card group hover:border-purple-500/50">
                    <div class="text-4xl mb-4">💻</div>
                    <h3 class="mb-2 gradient-text-secondary">GitHub</h3>
                    <p class="text-sm">Open source projects and code</p>
                </a>

                <a href="https://www.tiktok.com/@jason.hand" target="_blank" rel="noopener noreferrer" class="project-card group hover:border-pink-500/50">
                    <div class="text-4xl mb-4">🎵</div>
                    <h3 class="mb-2 gradient-text">TikTok</h3>
                    <p class="text-sm">Quick tips and creative content</p>
                </a>

                <a href="https://www.linkedin.com/in/jasonhand24" target="_blank" rel="noopener noreferrer" class="project-card group hover:border-blue-500/50">
                    <div class="text-4xl mb-4">💼</div>
                    <h3 class="mb-2 gradient-text-secondary">LinkedIn</h3>
                    <p class="text-sm">Professional updates and networking</p>
                </a>
            </div>
        </div>
    </section>

    <!-- Datadog Section -->
    <section id="datadog" class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-8">
                <span class="scattered-letters">
                    <span>D</span><span>a</span><span>t</span><span>a</span><span>d</span><span>o</span><span>g</span>
                </span>
            </h2>
            <p class="text-center text-xl mb-16 max-w-3xl mx-auto">
                Engaging with the observability community through innovative projects, speaking engagements, educational content, and thought leadership.
            </p>
            <div class="grid md:grid-cols-2 gap-8">
                <div class="project-card">
                    <div class="mb-4">
                        <img src="/images/public-speaking.jpg" alt="Conference Talks" class="w-full h-48 object-cover rounded-lg" />
                    </div>
                    <h3 class="mb-4 gradient-text-secondary">Conference Talks & Webinars</h3>
                    <p class="mb-4 text-text-muted">Microsoft Build • Google Next • AWS re:Invent • Partner Webinars</p>
                    <p class="mb-6">
                        Speaking at major tech conferences and hosting educational webinars about observability, AI, and modern development practices.
                    </p>
                    <div class="flex gap-4">
                        <a href="/datadog/conference-talks" class="btn btn-secondary">View Talks & Webinars</a>
                        <a href="/datadog/conference-talks" class="btn btn-outline">Watch Playlist</a>
                    </div>
                </div>

                <div class="project-card">
                    <div class="mb-4">
                        <img src="/images/DatadogOn.jpg" alt="Live Streams & Content" class="w-full h-48 object-cover rounded-lg" />
                    </div>
                    <h3 class="mb-4 gradient-text">Live Streams & Content</h3>
                    <p class="mb-4 text-text-muted">AI Native DevCon • Datadog On • Webinars</p>
                    <p class="mb-6">Creating educational content through live streams and interactive sessions with the community.</p>
                    <div class="flex gap-4">
                        <a href="/datadog/live-streams" class="btn">Live Streams</a>
                        <a href="/datadog/datadog-on" class="btn btn-outline">Datadog On</a>
                    </div>
                </div>

                <div class="project-card">
                    <div class="mb-4">
                        <div class="w-full h-48 bg-gradient-to-br from-primary/20 to-accent/20 rounded-lg flex items-center justify-center">
                            <span class="text-4xl">🏆</span>
                        </div>
                    </div>
                    <h3 class="mb-4 gradient-text-secondary">DASH Conference</h3>
                    <p class="mb-4 text-text-muted">Annual User Conference • Community • Innovation</p>
                    <p class="mb-6">Contributing to Datadog's premier user conference through speaking, content planning, and community engagement.</p>
                    <div class="flex gap-4">
                        <a href="/datadog/dash" class="btn btn-secondary">DASH Details</a>
                        <a href="/datadog/dash" class="btn btn-outline">Learn More</a>
                    </div>
                </div>
            </div>
            <div class="text-center mt-12">
                <a href="/projects" class="btn btn-lg btn-outline">View All Datadog Work</a>
            </div>
        </div>
    </section>

    <!-- Demos Section -->
    <section id="demos" class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-8">
                <span class="scattered-letters">
                    <span>D</span><span>e</span><span>m</span><span>o</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>A</span><span>p</span><span>p</span><span>s</span>
                </span>
            </h2>
            <p class="text-center text-xl mb-16 max-w-3xl mx-auto">
                Interactive experiments and proof-of-concepts showcasing cutting-edge technologies and innovative ideas.
            </p>

            <!-- All Demos Grid -->
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
                {
                    allDemos.map((demo) => (
                        <div class="project-card group">
                            <div class="mb-4">
                                <div class="w-full h-40 rounded-lg overflow-hidden transition-transform group-hover:scale-105">
                                    <img
                                        src={getDemoImagePath(demo.id)}
                                        alt={`Screenshot of ${demo.title}`}
                                        class="w-full h-full object-cover"
                                        loading="lazy"
                                    />
                                </div>
                            </div>

                            <div class="flex items-center gap-2 mb-3">
                                <h3 class="gradient-text">{demo.title}</h3>
                                {demo.status !== 'live' && (
                                    <span
                                        class={`text-xs px-2 py-1 rounded-full ${
                                            demo.status === 'development' ? 'text-yellow-500' : 'text-blue-500'
                                        } bg-opacity-20`}
                                    >
                                        {demo.status === 'development' ? 'In Dev' : 'Preview'}
                                    </span>
                                )}
                            </div>

                            <p class="mb-4 text-sm text-text-muted">{demo.shortDescription}</p>

                            <div class="flex flex-wrap gap-1 mb-4">
                                {demo.tags.slice(0, 3).map((tag) => (
                                    <span class="text-xs px-2 py-1 bg-background-secondary rounded-full text-text-muted">{tag}</span>
                                ))}
                            </div>

                            <div class="flex flex-wrap gap-2">
                                <a href={demo.url} target="_blank" rel="noopener noreferrer" class="btn text-sm">
                                    {demo.status === 'development' ? 'Preview' : 'Try Demo'}
                                </a>
                                <a href={`/demos/${demo.id}`} class="btn btn-outline text-sm">
                                    Details
                                </a>
                                {hasBlogPostForDemo(demo.id) && (
                                    <a href={`/blog/${demo.id}-demo`} class="btn btn-outline text-sm border-accent/50 text-accent hover:bg-accent/10">
                                        📝 Blog Post
                                    </a>
                                )}
                            </div>
                        </div>
                    ))
                }
            </div>

            <div class="text-center">
                <a href="/demos" class="btn btn-lg btn-outline">Explore All {allDemos.length} Demos</a>
            </div>
        </div>
    </section>
</Layout>

<style>
    /* Smooth scrolling for anchor links */
    html {
        scroll-behavior: smooth;
    }

    /* Additional animations */
    @keyframes float {
        0%,
        100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-10px);
        }
    }

    .project-card:hover {
        animation: float 2s ease-in-out infinite;
    }
</style>
