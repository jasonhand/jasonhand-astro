---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Podcasts - Jason Hand">
    <!-- Hero Section -->
    <section class="section-hero relative">
        <div class="max-w-4xl mx-auto text-center relative z-10">
            <h1 class="mb-8">
                <span class="scattered-letters">
                    <span>P</span><span>o</span><span>d</span><span>c</span><span>a</span><span>s</span><span>t</span><span>s</span>
                </span>
            </h1>
            <p class="text-xl md:text-2xl mb-12 max-w-2xl mx-auto">
                Exploring technology, community, and developer relations through engaging podcast conversations and discussions.
            </p>
        </div>
    </section>

    <!-- Podcast Shows Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-8">
                <span class="scattered-letters">
                    <span>S</span><span>h</span><span>o</span><span>w</span><span>s</span>
                </span>
            </h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- AI Tools Lab -->
                <div class="project-card group cursor-pointer" onclick="window.location.href='/podcasts/ai-tools-lab'">
                    <div class="mb-4">
                        <img src="/images/ai-tools-lab-logo.png" alt="AI Tools Lab Logo" class="w-16 h-16 object-contain" />
                    </div>
                    <h3 class="mb-4 gradient-text">AI Tools Lab</h3>
                    <p class="mb-4">Experimental discussions about AI tools, applications, and the future of technology in developer workflows.</p>
                    <a href="/podcasts/ai-tools-lab" class="btn btn-outline">View Episodes</a>
                </div>

                <!-- The Community Pulse -->
                <div class="project-card group cursor-pointer" onclick="window.location.href='/podcasts/community-pulse'">
                    <div class="mb-4">
                        <img src="/images/CommunityPulse.png" alt="The Community Pulse Logo" class="w-16 h-16 object-contain" />
                    </div>
                    <h3 class="mb-4 gradient-text-secondary">The Community Pulse</h3>
                    <p class="mb-4">Deep conversations about developer relations, community building, and the evolving tech landscape.</p>
                    <a href="/podcasts/community-pulse" class="btn btn-outline">View Episodes</a>
                </div>

                <!-- After Pulse -->
                <div class="project-card group cursor-pointer" onclick="window.location.href='/podcasts/after-pulse'">
                    <div class="mb-4">
                        <img src="/images/AfterPulse.png" alt="After Pulse Logo" class="w-16 h-16 object-contain" />
                    </div>
                    <h3 class="mb-4 gradient-text">After Pulse</h3>
                    <p class="mb-4">Extended discussions and follow-up conversations from The Community Pulse episodes.</p>
                    <a href="/podcasts/after-pulse" class="btn btn-outline">View Episodes</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Guest Appearances Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-16">
                <span class="scattered-letters">
                    <span>G</span><span>u</span><span>e</span><span>s</span><span>t</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>A</span><span>p</span><span>p</span><span>e</span><span>a</span><span>r</span><span>a</span><span>n</span><span>c</span><span>e</span><span>s</span>
                </span>
            </h2>
            <div class="grid gap-8">
                <!-- Software Defined Interviews -->
                <div class="project-card">
                    <div class="mb-8">
                        <h3 class="mb-4 gradient-text text-3xl">The AI Tools Lab, conferences, devrel</h3>
                        <p class="mb-4 text-text-muted">Software Defined Interviews • Episode 115 • December 10th, 2025</p>
                        <p class="mb-6 text-lg">
                            Whitney and Coté chat with Jason about the challenges and rewards of organizing conferences, the impact of the pandemic on in-person events, 
                            and the nuances of developer relations. Jason shares his experiences with AI Tools Lab, vibe coding, and personal projects such as developing 
                            his own tools to replace commercial SaaS products.
                        </p>
                    </div>
                    <div class="mb-8">
                        <div class="aspect-video w-full rounded-lg overflow-hidden shadow-xl">
                            <iframe
                                class="w-full h-full"
                                src="https://www.youtube.com/embed/1jxmNoWv9WU"
                                title="The AI Tools Lab, conferences, devrel - Software Defined Interviews"
                                style="border: none;"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
                            ></iframe>
                        </div>
                    </div>
                    <div class="mb-6">
                        <h4 class="mb-3 font-semibold gradient-text">Topics Discussed:</h4>
                        <ul class="list-disc list-inside space-y-1 text-text-muted">
                            <li>Conference organization and challenges</li>
                            <li>AI Tools Lab and experimental development</li>
                            <li>Vibe coding and developer workflows</li>
                            <li>DevRel differences at large vs. mid-sized companies</li>
                            <li>Maintaining personal energy in high-demand roles</li>
                        </ul>
                    </div>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a 
                            href="https://www.softwaredefinedinterviews.com/115" 
                            target="_blank" 
                            rel="noopener noreferrer" 
                            class="btn btn-lg"
                        >
                            Listen Now
                        </a>
                        <a 
                            href="https://www.youtube.com/watch?v=1jxmNoWv9WU" 
                            target="_blank" 
                            rel="noopener noreferrer" 
                            class="btn btn-lg btn-secondary"
                        >
                            Watch on YouTube
                        </a>
                        <a 
                            href="https://www.softwaredefinedinterviews.com/" 
                            target="_blank" 
                            rel="noopener noreferrer" 
                            class="btn btn-lg btn-outline"
                        >
                            Software Defined Interviews
                        </a>
                    </div>
                </div>
                <!-- Guest Appearance -->
                <div class="project-card">
                    <div class="mb-8">
                        <h3 class="mb-4 gradient-text-secondary text-3xl">Guest Appearance</h3>
                        <p class="mb-4 text-text-muted">Podcast Guest Appearance</p>
                        <p class="mb-6 text-lg">
                            A podcast conversation covering technology, developer relations, and industry insights.
                        </p>
                    </div>
                    <div class="mb-8">
                        <div class="aspect-video w-full rounded-lg overflow-hidden shadow-xl">
                            <iframe
                                class="w-full h-full"
                                src="https://www.youtube.com/embed/YKu3MZu_A2g"
                                title="Guest Appearance - Podcast Interview"
                                style="border: none;"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
                            ></iframe>
                        </div>
                    </div>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a 
                            href="https://youtu.be/YKu3MZu_A2g?si=1nDMHnQijjGEF-Hb" 
                            target="_blank" 
                            rel="noopener noreferrer" 
                            class="btn btn-lg btn-secondary"
                        >
                            Watch on YouTube
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Episodes Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-16">
                <span class="scattered-letters">
                    <span>F</span><span>e</span><span>a</span><span>t</span><span>u</span><span>r</span><span>e</span><span>d</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>E</span><span>p</span><span>i</span><span>s</span><span>o</span><span>d</span><span>e</span><span>s</span>
                </span>
            </h2>
            <div class="grid gap-8">
                <!-- Latest Community Pulse Episode -->
                <div class="project-card">
                    <div class="grid md:grid-cols-2 gap-8 items-center">
                        <div>
                            <img src="/images/CommunityPulse.png" alt="Community Pulse Episode 102" class="w-full h-64 object-cover rounded-lg mb-6" />
                        </div>
                        <div>
                            <h3 class="mb-4 gradient-text text-3xl">2025 End of Year Wrap-Up</h3>
                            <p class="mb-4 text-text-muted">The Community Pulse • Episode 102 • January 7th, 2026</p>
                            <p class="mb-6 text-lg">
                                In this year-end episode, we're reflecting on our 2025 DevRel conversations and the themes that defined the year. We revisit key insights 
                                from our guests, look at how the DevRel landscape continued to evolve, and call out the lessons that showed up again and again across our episodes.
                            </p>
                            <div class="flex flex-col sm:flex-row gap-4">
                                <a href="https://www.communitypulse.io/episodes" target="_blank" rel="noopener noreferrer" class="btn btn-lg">Listen Now</a>
                                <a href="/podcasts/community-pulse" class="btn btn-lg btn-outline">More Episodes</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Episode 101 -->
                <div class="project-card">
                    <div class="grid md:grid-cols-2 gap-8 items-center">
                        <div class="md:order-2">
                            <img
                                src="/images/CommunityPulse.png"
                                alt="Community Pulse Episode 101"
                                class="w-full h-64 object-cover rounded-lg mb-6"
                            />
                        </div>
                        <div class="md:order-1">
                            <h3 class="mb-4 gradient-text-secondary text-3xl">Non-tech Communities That Inform Our DevRel Activities</h3>
                            <p class="mb-4 text-text-muted">The Community Pulse • Episode 101 • November 7th, 2025</p>
                            <p class="mb-6 text-lg">
                                Our lived experiences often inform our work. This is true in the world of DevRel as well. Whether you have organized a church group, 
                                been in a band, or put together a big party - some of those experiences will leak over into how you see community and how you work in 
                                the Developer Relations world.
                            </p>
                            <div class="flex flex-col sm:flex-row gap-4">
                                <a href="https://www.communitypulse.io/episodes" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-secondary"
                                    >Listen Now</a
                                >
                                <a href="/podcasts/community-pulse" class="btn btn-lg btn-outline">All Episodes</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Episode 100 - Milestone -->
                <div class="project-card">
                    <div class="grid md:grid-cols-2 gap-8 items-center">
                        <div>
                            <img src="/images/CommunityPulse.png" alt="Community Pulse Episode 100" class="w-full h-64 object-cover rounded-lg mb-6" />
                        </div>
                        <div>
                            <h3 class="mb-4 gradient-text text-3xl">What's Changed Since the Community Pulse Started!</h3>
                            <p class="mb-4 text-text-muted">The Community Pulse • Episode 100 • September 26th, 2025</p>
                            <p class="mb-6 text-lg">
                                It's been 10 years since the start of Community Pulse and, appropriately enough, we've reached the milestone of 100 episodes. 
                                To celebrate, we invited Jono Bacon -- our very first guest on the show -- and SJ Morris -- a former host of the show -- to join us 
                                and reminisce about changes in the DevRel industry as well as how we've changed personally and professionally over the last 10 years.
                            </p>
                            <div class="flex flex-col sm:flex-row gap-4">
                                <a href="https://www.communitypulse.io/episodes" target="_blank" rel="noopener noreferrer" class="btn btn-lg">Listen Now</a>
                                <a href="/podcasts/community-pulse" class="btn btn-lg btn-outline">More Episodes</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Episode 99 -->
                <div class="project-card">
                    <div class="grid md:grid-cols-2 gap-8 items-center">
                        <div class="md:order-2">
                            <img src="/images/CommunityPulse.png" alt="Community Pulse Episode 99" class="w-full h-64 object-cover rounded-lg mb-6" />
                        </div>
                        <div class="md:order-1">
                            <h3 class="mb-4 gradient-text-secondary text-3xl">DevRel Tooling</h3>
                            <p class="mb-4 text-text-muted">The Community Pulse • Episode 99 • August 9th, 2025</p>
                            <p class="mb-6 text-lg">
                                In this episode, Jason, Wesley, and Mary share some of our favorite tools of the trade—from live streaming setups and demo-building 
                                tricks to the software and hardware we rely on for recording videos and tracking metrics. Join us for a practical, behind-the-scenes 
                                look at the gear and workflows that help us connect with developers and communities every day.
                            </p>
                            <div class="flex flex-col sm:flex-row gap-4">
                                <a href="https://www.communitypulse.io/episodes" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-secondary"
                                    >Listen Now</a
                                >
                                <a href="/podcasts/community-pulse" class="btn btn-lg btn-outline">All Episodes</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Recent Episodes Grid -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-16">
                <span class="scattered-letters">
                    <span>R</span><span>e</span><span>c</span><span>e</span><span>n</span><span>t</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>E</span><span>p</span><span>i</span><span>s</span><span>o</span><span>d</span><span>e</span><span>s</span>
                </span>
            </h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="project-card group">
                    <img src="/images/CommunityPulse.png" alt="Episode 102" class="w-full h-32 object-cover rounded-lg mb-4" />
                    <h4 class="gradient-text font-bold mb-2">EP 102: 2025 Wrap-Up</h4>
                    <p class="text-sm text-text-muted mb-4">Reflecting on 2025 DevRel conversations and themes</p>
                    <a href="https://www.communitypulse.io/episodes" target="_blank" rel="noopener noreferrer" class="btn btn-sm">Listen</a>
                </div>
                <div class="project-card group">
                    <img src="/images/CommunityPulse.png" alt="Episode 101" class="w-full h-32 object-cover rounded-lg mb-4" />
                    <h4 class="gradient-text-secondary font-bold mb-2">EP 101: Non-tech Communities</h4>
                    <p class="text-sm text-text-muted mb-4">How lived experiences inform DevRel work</p>
                    <a href="https://www.communitypulse.io/episodes" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-secondary">Listen</a>
                </div>
                <div class="project-card group">
                    <img src="/images/CommunityPulse.png" alt="Episode 100" class="w-full h-32 object-cover rounded-lg mb-4" />
                    <h4 class="gradient-text font-bold mb-2">EP 100: 10 Years!</h4>
                    <p class="text-sm text-text-muted mb-4">Milestone episode celebrating 10 years and 100 episodes</p>
                    <a href="https://www.communitypulse.io/episodes" target="_blank" rel="noopener noreferrer" class="btn btn-sm">Listen</a>
                </div>
                <div class="project-card group">
                    <img src="/images/CommunityPulse.png" alt="Episode 99" class="w-full h-32 object-cover rounded-lg mb-4" />
                    <h4 class="gradient-text-secondary font-bold mb-2">EP 99: DevRel Tooling</h4>
                    <p class="text-sm text-text-muted mb-4">Tools of the trade for DevRel professionals</p>
                    <a href="https://www.communitypulse.io/episodes" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-secondary">Listen</a>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="section">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="mb-8 gradient-text">Subscribe & Follow</h2>
            <p class="text-xl mb-12">Stay updated with the latest episodes and join the conversation about technology, community, and developer relations.</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
                <a href="https://www.communitypulse.io/" target="_blank" rel="noopener noreferrer" class="btn btn-lg">Community Pulse</a>
                <a href="/about" class="btn btn-lg btn-outline">About Me</a>
            </div>

            <!-- Social Links -->
            <div class="border-t border-gray-800 pt-12">
                <h3 class="mb-6 gradient-text-secondary">Connect & Listen</h3>
                <div class="flex flex-wrap justify-center gap-6">
                    <a href="https://youtube.com/@jhand" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-primary transition-colors">
                        📺 YouTube
                    </a>
                    <a
                        href="https://github.com/jasonhand"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-secondary transition-colors"
                    >
                        💻 GitHub
                    </a>
                    <a
                        href="https://www.tiktok.com/@jason.hand"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-accent transition-colors"
                    >
                        🎵 TikTok
                    </a>
                    <a
                        href="https://www.linkedin.com/in/jasonhand24"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-primary transition-colors"
                    >
                        💼 LinkedIn
                    </a>
                    <a
                        href="https://open.spotify.com/show/3I7g5W9fMSgpWu38zZMjet"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-secondary transition-colors"
                    >
                        🎧 Spotify
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- DevOps.com Interview Section -->
    <section class="section">
        <div class="max-w-4xl mx-auto">
            <h2 class="text-center mb-8">
                <span class="scattered-letters">
                    <span>I</span><span>n</span><span>t</span><span>e</span><span>r</span><span>v</span><span>i</span><span>e</span><span>w</span><span>s</span>
                </span>
            </h2>
            <div class="project-card">
                <div class="mb-8">
                    <h3 class="mb-4 gradient-text text-3xl">DevOps.com Interview</h3>
                    <p class="mb-4 text-text-muted">DevOps.com • 2014</p>
                    <p class="mb-6 text-lg">
                        A conversation from 10 years ago discussing DevOps practices, community building, and the evolving technology landscape.
                    </p>
                </div>
                <div class="mb-8">
                    <div class="aspect-video w-full rounded-lg overflow-hidden shadow-xl">
                        <iframe
                            class="w-full h-full"
                            src="https://www.youtube.com/embed/Lu5hpEnZS0M"
                            title="DevOps.com Interview with Jason Hand"
                            style="border: none;"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
                        ></iframe>
                    </div>
                </div>
                <div class="flex flex-col sm:flex-row gap-4">
                    <a 
                        href="https://youtu.be/Lu5hpEnZS0M?si=TtiYwC77_777UjGc" 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        class="btn btn-lg"
                    >
                        Watch on YouTube
                    </a>
                </div>
            </div>
            <div class="project-card mt-8">
                <div class="mb-8">
                    <h3 class="mb-4 gradient-text-secondary text-3xl">Podcast Interview</h3>
                    <p class="mb-4 text-text-muted">Podcast Interview</p>
                    <p class="mb-6 text-lg">
                        A podcast conversation covering technology, developer relations, and industry insights.
                    </p>
                </div>
                <div class="mb-8">
                    <div class="aspect-video w-full rounded-lg overflow-hidden shadow-xl">
                        <iframe
                            class="w-full h-full"
                            src="https://www.youtube.com/embed/W18IyJUFTiQ"
                            title="Podcast Interview with Jason Hand"
                            style="border: none;"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
                        ></iframe>
                    </div>
                </div>
                <div class="flex flex-col sm:flex-row gap-4">
                    <a 
                        href="https://youtu.be/W18IyJUFTiQ?si=2I-KAIz4D4Nxxip5" 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        class="btn btn-lg btn-secondary"
                    >
                        Watch on YouTube
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>
