---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Podcasts - Jason Hand">
    <!-- Hero Section -->
    <section class="section-hero relative">
        <div class="max-w-4xl mx-auto text-center relative z-10">
            <h1 class="mb-8">
                <span class="scattered-letters">
                    <span>P</span><span>o</span><span>d</span><span>c</span><span>a</span><span>s</span><span>t</span><span>s</span>
                </span>
            </h1>
            <p class="text-xl md:text-2xl mb-12 max-w-2xl mx-auto">
                Exploring technology, community, and developer relations through engaging podcast conversations and discussions.
            </p>
        </div>
    </section>

    <!-- Podcast Shows Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-8">
                <span class="scattered-letters">
                    <span>S</span><span>h</span><span>o</span><span>w</span><span>s</span>
                </span>
            </h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- AI Tools Lab -->
                <div class="project-card group cursor-pointer" onclick="window.location.href='/podcasts/ai-tools-lab'">
                    <div class="mb-4">
                        <img src="/images/ai-tools-lab-logo.png" alt="AI Tools Lab Logo" class="w-16 h-16 object-contain" />
                    </div>
                    <h3 class="mb-4 gradient-text">AI Tools Lab</h3>
                    <p class="mb-4">Experimental discussions about AI tools, applications, and the future of technology in developer workflows.</p>
                    <a href="/podcasts/ai-tools-lab" class="btn btn-outline">View Episodes</a>
                </div>

                <!-- The Community Pulse -->
                <div class="project-card group cursor-pointer" onclick="window.location.href='/podcasts/community-pulse'">
                    <div class="mb-4">
                        <img src="/images/CommunityPulse.png" alt="The Community Pulse Logo" class="w-16 h-16 object-contain" />
                    </div>
                    <h3 class="mb-4 gradient-text-secondary">The Community Pulse</h3>
                    <p class="mb-4">Deep conversations about developer relations, community building, and the evolving tech landscape.</p>
                    <a href="/podcasts/community-pulse" class="btn btn-outline">View Episodes</a>
                </div>

                <!-- After Pulse -->
                <div class="project-card group cursor-pointer" onclick="window.location.href='/podcasts/after-pulse'">
                    <div class="mb-4">
                        <img src="/images/AfterPulse.png" alt="After Pulse Logo" class="w-16 h-16 object-contain" />
                    </div>
                    <h3 class="mb-4 gradient-text">After Pulse</h3>
                    <p class="mb-4">Extended discussions and follow-up conversations from The Community Pulse episodes.</p>
                    <a href="/podcasts/after-pulse" class="btn btn-outline">View Episodes</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Episodes Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-16">
                <span class="scattered-letters">
                    <span>F</span><span>e</span><span>a</span><span>t</span><span>u</span><span>r</span><span>e</span><span>d</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>E</span><span>p</span><span>i</span><span>s</span><span>o</span><span>d</span><span>e</span><span>s</span>
                </span>
            </h2>
            <div class="grid gap-8">
                <!-- Latest Community Pulse Episode -->
                <div class="project-card">
                    <div class="grid md:grid-cols-2 gap-8 items-center">
                        <div>
                            <img src="/images/CommunityPulse.png" alt="Community Pulse Episode 98" class="w-full h-64 object-cover rounded-lg mb-6" />
                        </div>
                        <div>
                            <h3 class="mb-4 gradient-text text-3xl">Work/Life Blur: Navigating the Grey</h3>
                            <p class="mb-4 text-text-muted">The Community Pulse • Episode 98</p>
                            <p class="mb-6 text-lg">
                                Sometimes work stretches beyond "normal" hours, and while we might welcome that when we're energized by the project, other times
                                it's a real struggle. Jason, PJ, and Mary unpack the difference between working late because we love the job versus doing it
                                just to meet a deadline.
                            </p>
                            <div class="flex flex-col sm:flex-row gap-4">
                                <a href="https://www.communitypulse.io/episodes" target="_blank" rel="noopener noreferrer" class="btn btn-lg">Listen Now</a>
                                <a href="/podcasts/community-pulse" class="btn btn-lg btn-outline">More Episodes</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Episode 97 -->
                <div class="project-card">
                    <div class="grid md:grid-cols-2 gap-8 items-center">
                        <div class="md:order-2">
                            <img
                                src="/images/screenshots/ai_tools_quiz.png"
                                alt="Community Pulse Episode 97"
                                class="w-full h-64 object-cover rounded-lg mb-6"
                            />
                        </div>
                        <div class="md:order-1">
                            <h3 class="mb-4 gradient-text-secondary text-3xl">Vibing on Vibe Coding</h3>
                            <p class="mb-4 text-text-muted">The Community Pulse • Episode 97</p>
                            <p class="mb-6 text-lg">
                                "Vibe coding" is gaining traction as a new way to approach software development—but what does it actually mean? We unpack the
                                term, explore how it's shaping the developer experience, and examine its potential to transform developer relations.
                            </p>
                            <div class="flex flex-col sm:flex-row gap-4">
                                <a href="https://www.communitypulse.io/episodes" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-secondary"
                                    >Listen Now</a
                                >
                                <a href="/podcasts/community-pulse" class="btn btn-lg btn-outline">All Episodes</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Episode 96 -->
                <div class="project-card">
                    <div class="grid md:grid-cols-2 gap-8 items-center">
                        <div>
                            <img src="/images/screenshots/jhand_tv.png" alt="Community Pulse Episode 96" class="w-full h-64 object-cover rounded-lg mb-6" />
                        </div>
                        <div>
                            <h3 class="mb-4 gradient-text text-3xl">The Decline of Technical Influencers</h3>
                            <p class="mb-4 text-text-muted">The Community Pulse • Episode 96</p>
                            <p class="mb-6 text-lg">
                                There has been a lot of chat about the decline of the tech influencer. Where have they all gone? Is tech influence too heavy or
                                too light? PJ, Mary, Wesley, and Jason share their opinions about "capital I" Influencers and where DevRel falls into all of
                                this.
                            </p>
                            <div class="flex flex-col sm:flex-row gap-4">
                                <a href="https://www.communitypulse.io/episodes" target="_blank" rel="noopener noreferrer" class="btn btn-lg">Listen Now</a>
                                <a href="/podcasts/community-pulse" class="btn btn-lg btn-outline">More Episodes</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Episode 95 -->
                <div class="project-card">
                    <div class="grid md:grid-cols-2 gap-8 items-center">
                        <div class="md:order-2">
                            <img src="/images/CP93.jpg" alt="Community Pulse Episode 95" class="w-full h-64 object-cover rounded-lg mb-6" />
                        </div>
                        <div class="md:order-1">
                            <h3 class="mb-4 gradient-text-secondary text-3xl">The Importance of Humility and Sincerity in DevRel</h3>
                            <p class="mb-4 text-text-muted">The Community Pulse • Episode 95</p>
                            <p class="mb-6 text-lg">
                                Communicating the message is only part of the job of a DevRel practitioner - there's also the method. Ensuring you share the
                                same alignment and you are seen as a member of the community is even more important than being able to educate a community.
                            </p>
                            <div class="flex flex-col sm:flex-row gap-4">
                                <a href="https://www.communitypulse.io/episodes" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-secondary"
                                    >Listen Now</a
                                >
                                <a href="/podcasts/community-pulse" class="btn btn-lg btn-outline">All Episodes</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Recent Episodes Grid -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-16">
                <span class="scattered-letters">
                    <span>R</span><span>e</span><span>c</span><span>e</span><span>n</span><span>t</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>E</span><span>p</span><span>i</span><span>s</span><span>o</span><span>d</span><span>e</span><span>s</span>
                </span>
            </h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="project-card group">
                    <img src="/images/CP93.jpg" alt="Episode 94" class="w-full h-32 object-cover rounded-lg mb-4" />
                    <h4 class="gradient-text font-bold mb-2">EP 94: 2024 Review</h4>
                    <p class="text-sm text-text-muted mb-4">Looking back on 2024 and ahead to 2025</p>
                    <a href="https://www.communitypulse.io/episodes" target="_blank" class="btn btn-sm">Listen</a>
                </div>
                <div class="project-card group">
                    <img src="/images/CP92.jpg" alt="Episode 93" class="w-full h-32 object-cover rounded-lg mb-4" />
                    <h4 class="gradient-text-secondary font-bold mb-2">EP 93: DevRel Foundation</h4>
                    <p class="text-sm text-text-muted mb-4">The new DevRel Foundation from Linux Foundation</p>
                    <a href="https://www.communitypulse.io/episodes" target="_blank" class="btn btn-sm btn-secondary">Listen</a>
                </div>
                <div class="project-card group">
                    <img src="/images/CP91.jpg" alt="Episode 92" class="w-full h-32 object-cover rounded-lg mb-4" />
                    <h4 class="gradient-text font-bold mb-2">EP 92: DevRel Hiring</h4>
                    <p class="text-sm text-text-muted mb-4">Why DevRel hiring is broken</p>
                    <a href="https://www.communitypulse.io/episodes" target="_blank" class="btn btn-sm">Listen</a>
                </div>
                <div class="project-card group">
                    <img src="/images/CP90.jpg" alt="Episode 91" class="w-full h-32 object-cover rounded-lg mb-4" />
                    <h4 class="gradient-text-secondary font-bold mb-2">EP 91: What is Maturity?</h4>
                    <p class="text-sm text-text-muted mb-4">Defining mature communities and teams</p>
                    <a href="https://www.communitypulse.io/episodes" target="_blank" class="btn btn-sm btn-secondary">Listen</a>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="section">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="mb-8 gradient-text">Subscribe & Follow</h2>
            <p class="text-xl mb-12">Stay updated with the latest episodes and join the conversation about technology, community, and developer relations.</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
                <a href="https://www.communitypulse.io/" target="_blank" rel="noopener noreferrer" class="btn btn-lg">Community Pulse</a>
                <a href="/about" class="btn btn-lg btn-outline">About Me</a>
            </div>

            <!-- Social Links -->
            <div class="border-t border-gray-800 pt-12">
                <h3 class="mb-6 gradient-text-secondary">Connect & Listen</h3>
                <div class="flex flex-wrap justify-center gap-6">
                    <a href="https://youtube.com/@jhand" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-primary transition-colors">
                        📺 YouTube
                    </a>
                    <a
                        href="https://github.com/jasonhand"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-secondary transition-colors"
                    >
                        💻 GitHub
                    </a>
                    <a
                        href="https://www.tiktok.com/@jason.hand"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-accent transition-colors"
                    >
                        🎵 TikTok
                    </a>
                    <a
                        href="https://www.linkedin.com/in/jasonhand24"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-primary transition-colors"
                    >
                        💼 LinkedIn
                    </a>
                    <a
                        href="https://open.spotify.com/show/3I7g5W9fMSgpWu38zZMjet"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-secondary transition-colors"
                    >
                        🎧 Spotify
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>
