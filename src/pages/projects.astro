---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Datadog - Jason Hand">
    <!-- Hero Section -->
    <section class="section-hero relative">
        <!-- Background Logo -->
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none" style="transform: translateY(20px);">
            <img src="/images/ai-tools-lab-logo.png" alt="AI Tools Lab Logo" class="w-96 md:w-[32rem] lg:w-[40rem] h-auto opacity-10 select-none" />
        </div>

        <div class="max-w-4xl mx-auto text-center relative z-10">
            <h1 class="mb-8">
                <span class="scattered-letters">
                    <span>D</span><span>a</span><span>t</span><span>a</span><span>d</span><span>o</span><span>g</span>
                </span>
            </h1>
            <p class="text-xl md:text-2xl mb-12 max-w-2xl mx-auto">
                My work at Datadog, building observability solutions and empowering developers with observability and AI dev tools.
            </p>
        </div>
    </section>

    <!-- Datadog Activities Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-16">
                <span class="scattered-letters">
                    <span>A</span><span>c</span><span>t</span><span>i</span><span>v</span><span>i</span><span>t</span><span>i</span><span>e</span><span>s</span>
                </span>
            </h2>
            <!-- Featured: AI Tools Lab -->
            <div class="mb-12">
                <div
                    class="project-card group cursor-pointer border-2 border-accent/30 hover:border-accent/50 transition-all bg-gradient-to-br from-accent/5 to-primary/5"
                    onclick="window.location.href='/datadog/ai-tools-lab'"
                >
                    <div class="flex items-start gap-6">
                        <div class="w-24 h-24 flex-shrink-0 rounded-lg overflow-hidden">
                            <video autoplay="" loop="" muted="" playsinline="" class="w-full h-full object-cover">
                                <source src="/images/AITL_Stinger.mp4" type="video/mp4" />
                                Your browser does not support the video tag.
                            </video>
                        </div>
                        <div class="flex-1">
                            <div class="flex items-center gap-2 mb-3">
                                <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-xs font-semibold">Featured Project</span>
                            </div>
                            <h3 class="mb-4 text-3xl gradient-text">AI Tools Lab</h3>
                            <p class="mb-4 text-lg">
                                Experimental AI tools and applications showcasing the future of observability and developer productivity.
                            </p>
                            <p class="mb-6 text-text-muted">
                                AI Tools Lab consists of 15-20 minute recorded technical demonstrations of hands-on experiences with AI-related tooling for
                                developers. Each episode explores different aspects of AI tools and their practical applications.
                            </p>
                            <div class="flex gap-4">
                                <a href="/datadog/ai-tools-lab" class="btn btn-lg">Explore AI Tools Lab</a>
                                <a href="https://youtube.com/@datadogcommunity" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-outline"
                                    >Watch Episodes</a
                                >
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Conference Talks & Webinars -->
                <div class="project-card group cursor-pointer" onclick="window.location.href='/datadog/conference-talks'">
                    <div class="text-4xl mb-4 gradient-text-secondary">🎤</div>
                    <h3 class="mb-4 gradient-text-secondary">Conference Talks & Webinars</h3>
                    <p class="mb-4">
                        Speaking engagements and educational sessions at major tech conferences and partner webinars with Google, Microsoft, AWS, and more.
                    </p>
                    <a href="/datadog/conference-talks" class="btn btn-outline">View Talks & Webinars</a>
                </div>

                <!-- Datadog On -->
                <div class="project-card group cursor-pointer" onclick="window.location.href='/datadog/datadog-on'">
                    <div class="text-4xl mb-4 gradient-text-secondary">📺</div>
                    <h3 class="mb-4 gradient-text-secondary">Datadog On</h3>
                    <p class="mb-4">Educational content series covering data science, generative AI chatbots, and observability best practices.</p>
                    <a href="/datadog/datadog-on" class="btn btn-outline">Watch Series</a>
                </div>

                <!-- Live Streams -->
                <div class="project-card group cursor-pointer" onclick="window.location.href='/datadog/live-streams'">
                    <div class="text-4xl mb-4 gradient-text">🔴</div>
                    <h3 class="mb-4 gradient-text">Live Streams</h3>
                    <p class="mb-4">Interactive live streaming sessions including AI Native DevCon and community-driven content.</p>
                    <a href="/datadog/live-streams" class="btn btn-outline">Join Streams</a>
                </div>

                <!-- DASH Conference -->
                <div class="project-card group cursor-pointer" onclick="window.location.href='/datadog/dash'">
                    <div class="text-4xl mb-4 gradient-text-secondary">🏆</div>
                    <h3 class="mb-4 gradient-text-secondary">DASH</h3>
                    <p class="mb-4">Datadog's annual user conference bringing together the observability community for learning and networking.</p>
                    <a href="/datadog/dash" class="btn btn-outline">Learn More</a>
                </div>

                <!-- Developer Advocacy Videos -->
                <div
                    class="project-card group cursor-pointer"
                    onclick="window.open('https://www.youtube.com/playlist?list=PLjR8CqndeyMq9NMYN_Hkto8WHr30ZZCuI', '_blank')"
                >
                    <div class="text-4xl mb-4 gradient-text">🎬</div>
                    <h3 class="mb-4 gradient-text">Developer Advocacy Videos</h3>
                    <p class="mb-4">Educational videos covering observability, AI tools, tutorials, and developer relations content.</p>
                    <a
                        href="https://www.youtube.com/playlist?list=PLjR8CqndeyMq9NMYN_Hkto8WHr30ZZCuI"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-outline"
                        onclick="event.stopPropagation()"
                    >
                        Watch Playlist
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Overview Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <div class="grid md:grid-cols-2 gap-16 items-center mb-20">
                <div>
                    <h2 class="mb-8 gradient-text">Datadog Experience</h2>
                    <p class="mb-6">
                        At Datadog, I work on building world-class observability solutions that help organizations monitor, troubleshoot, and optimize their
                        applications and infrastructure.
                    </p>
                    <p class="mb-6">
                        From developer tools to enterprise-scale monitoring platforms, my work focuses on creating intuitive experiences that make complex data
                        accessible and actionable.
                    </p>
                    <p>Every solution is built with scalability, reliability, and developer experience in mind, serving millions of users worldwide.</p>
                </div>
                <div class="relative">
                    <div class="w-full h-96 bg-gradient-to-br from-primary/20 to-secondary/20 rounded-2xl flex items-center justify-center">
                        <span class="text-6xl gradient-text">💼</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Projects Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-16">
                <span class="scattered-letters">
                    <span>K</span><span>e</span><span>y</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>C</span><span>o</span><span>n</span><span>t</span><span>r</span><span>i</span><span>b</span><span>u</span><span>t</span><span>i</span
                    ><span>o</span><span>n</span><span>s</span>
                </span>
            </h2>
            <div class="grid gap-12">
                <!-- Observability Platform -->
                <div class="project-card">
                    <div class="grid md:grid-cols-2 gap-8 items-center">
                        <div>
                            <div class="w-full h-64 bg-gradient-to-br from-primary/20 to-secondary/20 rounded-lg flex items-center justify-center mb-6">
                                <span class="text-6xl">📊</span>
                            </div>
                        </div>
                        <div>
                            <h3 class="mb-4 gradient-text text-3xl">Observability Platform</h3>
                            <p class="mb-4 text-text-muted">React • TypeScript • D3.js • WebSockets • Microservices</p>
                            <p class="mb-6 text-lg">
                                Building next-generation monitoring and observability tools that provide real-time insights into application performance,
                                infrastructure health, and user experience.
                            </p>
                            <div class="mb-6">
                                <h4 class="mb-3 font-semibold gradient-text">Key Features:</h4>
                                <ul class="list-disc list-inside space-y-1 text-text-muted">
                                    <li>Real-time metrics and alerting systems</li>
                                    <li>Interactive data visualization dashboards</li>
                                    <li>Distributed tracing and APM</li>
                                    <li>Log aggregation and analysis</li>
                                    <li>Infrastructure monitoring and mapping</li>
                                </ul>
                            </div>
                            <div class="flex flex-col sm:flex-row gap-4">
                                <a href="https://www.datadoghq.com/" target="_blank" rel="noopener noreferrer" class="btn btn-lg">View Platform</a>
                                <a href="https://docs.datadoghq.com/" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-outline">Documentation</a>
                                <a href="https://www.datadoghq.com/blog/" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-secondary">Blog</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Developer Tools -->
                <div class="project-card">
                    <div class="grid md:grid-cols-2 gap-8 items-center">
                        <div class="md:order-2">
                            <div class="w-full h-64 bg-gradient-to-br from-secondary/20 to-accent/20 rounded-lg flex items-center justify-center mb-6">
                                <span class="text-6xl">🛠️</span>
                            </div>
                        </div>
                        <div class="md:order-1">
                            <h3 class="mb-4 gradient-text-secondary text-3xl">Developer Tools & SDKs</h3>
                            <p class="mb-4 text-text-muted">JavaScript • Python • Go • REST APIs • GraphQL</p>
                            <p class="mb-6 text-lg">
                                Creating developer-first tools and SDKs that make it easy to integrate monitoring and observability into any application or
                                infrastructure.
                            </p>
                            <div class="mb-6">
                                <h4 class="mb-3 font-semibold gradient-text-secondary">Key Features:</h4>
                                <ul class="list-disc list-inside space-y-1 text-text-muted">
                                    <li>Multi-language SDK support</li>
                                    <li>Comprehensive API documentation</li>
                                    <li>Interactive code examples</li>
                                    <li>Developer-friendly onboarding</li>
                                    <li>Community-driven integrations</li>
                                </ul>
                            </div>
                            <div class="flex flex-col sm:flex-row gap-4">
                                <a href="https://docs.datadoghq.com/developers/" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-secondary"
                                    >Developer Docs</a
                                >
                                <a href="https://github.com/DataDog" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-outline">GitHub</a>
                                <a href="https://www.datadoghq.com/integrations/" target="_blank" rel="noopener noreferrer" class="btn btn-lg">Integrations</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Security & Compliance -->
                <div class="project-card">
                    <div class="grid md:grid-cols-2 gap-8 items-center">
                        <div>
                            <div class="w-full h-64 bg-gradient-to-br from-accent/20 to-primary/20 rounded-lg flex items-center justify-center mb-6">
                                <span class="text-6xl">🔒</span>
                            </div>
                        </div>
                        <div>
                            <h3 class="mb-4 gradient-text text-3xl">Security & Compliance</h3>
                            <p class="mb-4 text-text-muted">Security Monitoring • SIEM • Threat Detection • Compliance</p>
                            <p class="mb-6 text-lg">
                                Building security monitoring solutions that help organizations detect threats, investigate incidents, and maintain compliance
                                across their infrastructure.
                            </p>
                            <div class="mb-6">
                                <h4 class="mb-3 font-semibold gradient-text">Key Features:</h4>
                                <ul class="list-disc list-inside space-y-1 text-text-muted">
                                    <li>Real-time threat detection and alerting</li>
                                    <li>Security information and event management</li>
                                    <li>Compliance monitoring and reporting</li>
                                    <li>Incident investigation workflows</li>
                                    <li>Integration with security tools</li>
                                </ul>
                            </div>
                            <div class="flex flex-col sm:flex-row gap-4">
                                <a href="https://www.datadoghq.com/product/security-platform/" target="_blank" rel="noopener noreferrer" class="btn btn-lg"
                                    >Security Platform</a
                                >
                                <a href="https://docs.datadoghq.com/security/" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-outline"
                                    >Security Docs</a
                                >
                                <a
                                    href="https://www.datadoghq.com/blog/tag/security/"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="btn btn-lg btn-secondary">Security Blog</a
                                >
                            </div>
                        </div>
                    </div>
                </div>

                <!-- AI & Machine Learning -->
                <div class="project-card">
                    <div class="grid md:grid-cols-2 gap-8 items-center">
                        <div class="md:order-2">
                            <div class="w-full h-64 bg-gradient-to-br from-primary/20 to-accent/20 rounded-lg flex items-center justify-center mb-6">
                                <span class="text-6xl">🤖</span>
                            </div>
                        </div>
                        <div class="md:order-1">
                            <h3 class="mb-4 gradient-text-secondary text-3xl">AI & Machine Learning</h3>
                            <p class="mb-4 text-text-muted">Machine Learning • Anomaly Detection • Predictive Analytics • AI</p>
                            <p class="mb-6 text-lg">
                                Leveraging AI and machine learning to provide intelligent insights, anomaly detection, and predictive analytics for modern
                                observability platforms.
                            </p>
                            <div class="mb-6">
                                <h4 class="mb-3 font-semibold gradient-text-secondary">Key Features:</h4>
                                <ul class="list-disc list-inside space-y-1 text-text-muted">
                                    <li>Intelligent anomaly detection</li>
                                    <li>Predictive alerting and forecasting</li>
                                    <li>Automated root cause analysis</li>
                                    <li>ML-powered insights and recommendations</li>
                                    <li>Adaptive monitoring thresholds</li>
                                </ul>
                            </div>
                            <div class="flex flex-col sm:flex-row gap-4">
                                <a href="https://www.datadoghq.com/product/watchdog/" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-secondary"
                                    >Watchdog AI</a
                                >
                                <a href="https://docs.datadoghq.com/watchdog/" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-outline"
                                    >AI Docs</a
                                >
                                <a href="https://www.datadoghq.com/blog/tag/machine-learning/" target="_blank" rel="noopener noreferrer" class="btn btn-lg"
                                    >ML Blog</a
                                >
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Developer Advocacy Videos Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-center mb-16">
                <span class="scattered-letters">
                    <span>D</span><span>e</span><span>v</span><span>e</span><span>l</span><span>o</span><span>p</span><span>e</span><span>r</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>A</span><span>d</span><span>v</span><span>o</span><span>c</span><span>a</span><span>c</span><span>y</span>
                </span>
                <br />
                <span class="scattered-letters">
                    <span>V</span><span>i</span><span>d</span><span>e</span><span>o</span><span>s</span>
                </span>
            </h2>
            <div class="project-card">
                <div class="grid md:grid-cols-2 gap-8 items-center">
                    <div>
                        <h3 class="mb-4 gradient-text text-3xl">Educational Content & Tutorials</h3>
                        <p class="mb-6 text-lg">
                            A collection of videos covering observability best practices, developer tools, AI applications, and hands-on tutorials to help
                            developers build better monitoring and observability solutions.
                        </p>
                        <div class="mb-6">
                            <h4 class="mb-3 font-semibold gradient-text">Topics Covered:</h4>
                            <ul class="list-disc list-inside space-y-1 text-text-muted">
                                <li>Observability and monitoring best practices</li>
                                <li>AI tools and developer productivity</li>
                                <li>Hands-on tutorials and demonstrations</li>
                                <li>Community engagement and developer relations</li>
                                <li>Technical deep-dives and case studies</li>
                            </ul>
                        </div>
                        <div class="flex flex-col sm:flex-row gap-4">
                            <a
                                href="https://www.youtube.com/playlist?list=PLjR8CqndeyMq9NMYN_Hkto8WHr30ZZCuI"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="btn btn-lg"
                            >
                                Watch Playlist
                            </a>
                            <a href="https://youtube.com/@jhand" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-outline"> View Channel </a>
                        </div>
                    </div>
                    <div class="relative">
                        <div class="w-full aspect-video bg-gradient-to-br from-primary/20 to-secondary/20 rounded-lg overflow-hidden">
                            <iframe
                                class="w-full h-full"
                                src="https://www.youtube.com/embed/videoseries?list=PLjR8CqndeyMq9NMYN_Hkto8WHr30ZZCuI"
                                title="Developer Advocacy Videos Playlist"
                                style="border: none;"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
                            ></iframe>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="section">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="mb-8 gradient-text">Explore My Work</h2>
            <p class="text-xl mb-12">Discover my experimental applications, developer relations activities, and creative projects beyond my work at Datadog.</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
                <a href="/demos" class="btn btn-lg">Explore Demos</a>
            </div>

            <!-- Social Links -->
            <div class="border-t border-gray-800 pt-12">
                <h3 class="mb-6 gradient-text-secondary">Follow My Datadog Journey</h3>
                <div class="flex flex-wrap justify-center gap-6">
                    <a href="https://youtube.com/@jhand" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-primary transition-colors">
                        📺 YouTube
                    </a>
                    <a
                        href="https://github.com/jasonhand"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-secondary transition-colors"
                    >
                        💻 GitHub
                    </a>
                    <a
                        href="https://www.tiktok.com/@jason.hand"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-accent transition-colors"
                    >
                        🎵 TikTok
                    </a>
                    <a
                        href="https://www.linkedin.com/in/jasonhand24"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-primary transition-colors"
                    >
                        💼 LinkedIn
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Video Section -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <div class="w-full max-w-sm mx-auto aspect-[9/16] bg-gradient-to-br from-primary/20 to-secondary/20 rounded-2xl overflow-hidden shadow-xl">
                <iframe
                    class="w-full h-full"
                    src="https://www.youtube.com/embed/Nm51HJteoXk"
                    title="Portrait Video"
                    style="border: none;"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"></iframe>
            </div>
        </div>
    </section>
</Layout>
