---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Work - Jason Hand">
    <!-- Hero Section -->
    <section class="section-hero">
        <div class="max-w-4xl mx-auto text-center">
            <h1 class="mb-6">
                <span class="scattered-letters">
                    <span>W</span><span>o</span><span>r</span><span>k</span>
                </span>
            </h1>
            <p class="text-xl text-text-muted max-w-2xl mx-auto">
                Professional work, projects, and contributions in developer relations and AI research
            </p>
        </div>
    </section>

    <!-- Work Categories -->
    <section class="section">
        <div class="max-w-6xl mx-auto">
            <!-- Featured: AI Tools Lab -->
            <div class="mb-12">
                <article class="project-card group cursor-pointer border-2 border-accent/30 hover:border-accent/50 transition-all" onclick="window.location.href='/datadog/ai-tools-lab'">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-20 h-20 bg-gradient-to-br from-accent/30 to-primary/30 rounded-2xl flex items-center justify-center">
                            <span class="text-4xl">🧪</span>
                        </div>
                        <div class="flex-1">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="px-3 py-1 bg-accent/20 text-accent rounded-full text-xs font-semibold">Featured Project</span>
                            </div>
                            <h3 class="mb-2 text-2xl gradient-text">AI Tools Lab</h3>
                            <p class="text-text-muted">Experimental AI research and development • Innovation • Research</p>
                        </div>
                    </div>
                    <p class="text-lg mb-4">
                        Research and experimentation with AI tools for developers, including LLMs, automation, and observability. 
                        AI Tools Lab consists of 15-20 minute recorded technical demonstrations of hands-on experiences with AI-related tooling.
                    </p>
                    <div class="flex items-center justify-between">
                        <span class="text-accent font-semibold text-lg">Explore AI Tools Lab →</span>
                    </div>
                </article>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-2 gap-8">
                <!-- Datadog Projects -->
                <article class="project-card group cursor-pointer" onclick="window.location.href='/projects'">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-16 h-16 bg-gradient-to-br from-primary/30 to-secondary/30 rounded-2xl flex items-center justify-center">
                            <span class="text-3xl">🐕</span>
                        </div>
                        <div>
                            <h3 class="mb-2">Datadog Projects</h3>
                            <p class="text-text-muted">Developer advocacy and AI research initiatives</p>
                        </div>
                    </div>
                    <p class="text-text-muted mb-4">
                        Leading developer advocacy efforts, AI tool development, and community building at Datadog's Developer Relations team.
                    </p>
                    <div class="flex items-center justify-between">
                        <span class="text-primary font-medium">Explore Projects →</span>
                    </div>
                </article>

                <!-- Conference Talks & Webinars -->
                <article class="project-card group cursor-pointer" onclick="window.location.href='/datadog/conference-talks'">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-16 h-16 bg-gradient-to-br from-secondary/30 to-accent/30 rounded-2xl flex items-center justify-center">
                            <span class="text-3xl">🎤</span>
                        </div>
                        <div>
                            <h3 class="mb-2">Conference Talks & Webinars</h3>
                            <p class="text-text-muted">Speaking engagements and educational sessions</p>
                        </div>
                    </div>
                    <p class="text-text-muted mb-4">
                        Technical presentations and webinars on DevOps, observability, AI, and community building at conferences and with technology partners.
                    </p>
                    <div class="flex items-center justify-between">
                        <span class="text-primary font-medium">View Talks & Webinars →</span>
                    </div>
                </article>

                <!-- Live Streams -->
                <article class="project-card group cursor-pointer" onclick="window.location.href='/datadog/live-streams'">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-16 h-16 bg-gradient-to-br from-accent/30 to-primary/30 rounded-2xl flex items-center justify-center">
                            <span class="text-3xl">📺</span>
                        </div>
                        <div>
                            <h3 class="mb-2">Live Streams</h3>
                            <p class="text-text-muted">Educational content and community engagement</p>
                        </div>
                    </div>
                    <p class="text-text-muted mb-4">
                        Regular live streaming sessions covering observability, DevOps practices, and emerging technologies.
                    </p>
                    <div class="flex items-center justify-between">
                        <span class="text-primary font-medium">Watch Streams →</span>
                    </div>
                </article>
            </div>
        </div>
    </section>
</Layout>